    	AnchorPoint = Vector2.new(0.5, 0),
    	BackgroundTransparency = 1,
    	Position = UDim2.fromScale(0.5, 0.22),
    	Size = UDim2.fromScale(0.94, 0.48),
    	ZIndex = 120,
    }, panel)

    make("UIListLayout", {
