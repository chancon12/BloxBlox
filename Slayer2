    			DisplayName = "SilK", -- Text shown in the GUI.
    			Icon = "rbxassetid://86755077727133",
    		},
    	},

    	WenIcon = "rbxassetid://119954170187936",
    }

    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local localPlayer = Players.LocalPlayer
    assert(localPlayer, "AFK Resource Monitor must run on the client")

    local playerGui = waitForChildDebug(localPlayer, "PlayerGui")
    local oldGui = playerGui:FindFirstChild("AFKResourceMonitor")

    if oldGui then
        debugPrint("AFK", "Replacing existing AFKResourceMonitor GUI")
    	oldGui:Destroy()
    end

    local COLORS = {
    	Gold = Color3.fromRGB(214, 157, 65),
    	GoldBright = Color3.fromRGB(255, 221, 150),
    	Cream = Color3.fromRGB(255, 240, 207),
    	Panel = Color3.fromRGB(13, 13, 15),
    	Card = Color3.fromRGB(20, 20, 23),
    	Black = Color3.fromRGB(0, 0, 0),
    }

    local function make(className, properties, parent)
    	local instance = Instance.new(className)

    	for property, value in pairs(properties or {}) do
    		instance[property] = value
    	end

    	instance.Parent = parent
    	return instance
    end

    local function addCorner(parent, radius)
    	return make("UICorner", {
    		CornerRadius = UDim.new(0, radius),
    	}, parent)
    end

    local function addStroke(parent, color, thickness, transparency)
    	return make("UIStroke", {
    		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    		Color = color,
    		Thickness = thickness,
    		Transparency = transparency or 0,
    	}, parent)
    end

    local function addTextConstraint(parent, minSize, maxSize)
    	return make("UITextSizeConstraint", {
    		MinTextSize = minSize,
    		MaxTextSize = maxSize,
    	}, parent)
    end

    local function formatNumber(value)
    	local number = math.floor(tonumber(value) or 0)
    	local sign = number < 0 and "-" or ""
    	local digits = tostring(math.abs(number))
    	local formatted = digits

    	repeat
    		local replacements
    		formatted, replacements = formatted:gsub("^(%d+)(%d%d%d)", "%1,%2")
    	until replacements == 0

    	return sign .. formatted
    end

    local function normalizedProfileName(name)
    	return string.gsub(name, "%-Studio$", "")
    end

    local targetName = CONFIG.PlayerName ~= "" and CONFIG.PlayerName or localPlayer.Name
    debugPrint("AFK", "Monitoring =", targetName, "RefreshSeconds =", CONFIG.RefreshSeconds)

    local function findProfile()
    	local playerService = ReplicatedStorage:FindFirstChild("Player_Service")
    	local dataRoot = playerService and playerService:FindFirstChild("Data")

    	if not dataRoot then
            return nil, playerService and "Waiting for Player_Service.Data" or "Waiting for Player_Service"
    	end

    	for _, profile in ipairs(dataRoot:GetChildren()) do
    		if normalizedProfileName(profile.Name):lower() == targetName:lower() then
    			return profile
    		end
    	end

        return nil, "Waiting for profile: " .. targetName
    end

    local function getActiveSlot(profile)
    	local equippedSlot = profile and profile:FindFirstChild("slotEquipped")
    	local slots = profile and profile:FindFirstChild("slots")

        if not equippedSlot or not slots then
            return nil, not equippedSlot and "Waiting for slotEquipped" or "Waiting for slots"
        end

        local slotName = "Slot" .. tostring(equippedSlot.Value)
        local activeSlot = slots:FindFirstChild(slotName)
        return activeSlot, not activeSlot and ("Waiting for " .. slotName) or nil
    end

    local expPerLevel = 60

    do
    	local cam = ReplicatedStorage:FindFirstChild("CAM")
    	local global = cam and cam:FindFirstChild("Global")
    	local settingsModule = global and global:FindFirstChild("gameSettings")

    	if settingsModule then
    		local ok, settings = pcall(requireDebug, settingsModule)
        debugPrint("AFK", "gameSettings require success =", ok, "resultType =", type(settings))
        if not ok then
            debugPrint("AFK", "gameSettings failed; using default expPerLevel; error =", settings)
        end

    		if ok and type(settings) == "table" and tonumber(settings.expPerLevel) then
    			expPerLevel = tonumber(settings.expPerLevel)
    		end
    	end
    end

    debugPrint("AFK", "expPerLevel =", expPerLevel, "Building monitor GUI")

    local function readLevel(slot)
    	local exp = slot and slot:FindFirstChild("Exp")
    	local goal = exp and exp:FindFirstChild("Goal")

    	if not goal or expPerLevel <= 0 then
            debugState("AFK Level", not goal and "Waiting for Exp.Goal" or "Invalid expPerLevel")
    		return 0
    	end

        debugState("AFK Level", "Exp.Goal loaded")
    	return math.floor(goal.Value / expPerLevel)
    end

    local function readItemTotal(slot, itemName)
    	local inventoryRoot = slot and slot:FindFirstChild("Inventory")
    	local inventory = inventoryRoot and inventoryRoot:FindFirstChild("Inventory")
    	local total = 0

    	if not inventory then
            debugState("AFK Inventory", "Waiting for Inventory.Inventory")
    		return total
    	end

        debugState("AFK Inventory", "Inventory loaded")

    	for _, item in ipairs(inventory:GetChildren()) do
    		if item.Name == itemName then
    			local amount = item:FindFirstChild("Amount")
    			total += amount and tonumber(amount.Value) or 1
    		end
    	end

    	return total
    end

    local screenGui = make("ScreenGui", {
    	Name = "AFKResourceMonitor",
    	DisplayOrder = CONFIG.DisplayOrder,
    	IgnoreGuiInset = true,
    	ResetOnSpawn = false,
    	ZIndexBehavior = Enum.ZIndexBehavior.Global,
    }, playerGui)

    pcall(function()
    	screenGui.ScreenInsets = Enum.ScreenInsets.None
    	screenGui.OnTopOfCoreBlur = true
    end)

    local overlay = make("Frame", {
    	Name = "Overlay",
    	BackgroundColor3 = COLORS.Black,
    	BackgroundTransparency = 0.28,
    	BorderSizePixel = 0,
    	Size = UDim2.fromScale(1, 1),
    	Visible = true,
    	ZIndex = 100,
    }, screenGui)

    local panel = make("Frame", {
    	Name = "MainPanel",
    	AnchorPoint = Vector2.new(0.5, 0.5),
    	BackgroundColor3 = COLORS.Panel,
    	BackgroundTransparency = 0.03,
    	BorderSizePixel = 0,
    	Position = UDim2.fromScale(0.5, 0.5),
    	Size = UDim2.fromScale(0.82, 0.55),
    	ZIndex = 110,
    }, overlay)

    addCorner(panel, 18)
    addStroke(panel, COLORS.Gold, 3, 0.08)

    local serverBanner = make("Frame", {
        Name = "ServerBanner",
        AnchorPoint = Vector2.new(0.5, 1),
        BackgroundColor3 = COLORS.Panel,
        BackgroundTransparency = 0.03,
        BorderSizePixel = 0,
        Position = UDim2.fromScale(0.5, 0.20),
        Size = UDim2.fromScale(0.82, 0.07),
        ZIndex = 110,
    }, overlay)

