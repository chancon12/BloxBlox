local Config = {
    ExpectedVersion = 194,
    FriendName = "FriendUsernameHere", -- Your friend's Roblox username.
}

local VERSION_PLACE_ID = 16205713724
local AFK_PLACE_ID = 136406881576517

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer

assert(LocalPlayer, "Run this on the client")

local triggered = false
local versionKickRequested = false
local privateJoinStarted = false
local disconnectConnection
local versionLabel

local success, err = pcall(function()
    disconnectConnection = GuiService.ErrorMessageChanged:Connect(function(message)
        if versionKickRequested or triggered or type(message) ~= "string" then
            return
        end

        local text = message:lower()
        local isAuthError = text:find("auth error", 1, true) ~= nil

        if game.PlaceId == VERSION_PLACE_ID and not isAuthError then
            return
        end

        local disconnected =
            isAuthError
            or text:find("kicked", 1, true)
            or text:find("disconnect", 1, true)
            or text:find("lost connection", 1, true)
            or text:find("slayers2: please rejoin for safety", 1, true)

        if not disconnected then
            return
        end

        triggered = true
        warn("Disconnect detected; starting freeze attempt:", message)

        -- Preserves your existing local freeze attempt.
        while true do
        end
    end)
end)

if not success then
    warn("Disconnect listener unavailable:", err)
end

local function canJoinPrivate()
    if versionKickRequested or triggered then
        return false
    end

    if game.PlaceId == VERSION_PLACE_ID then
        return versionLabel ~= nil
            and tonumber(versionLabel.Text) == Config.ExpectedVersion
    end

    return true
end

local function startPrivateJoin()
    if privateJoinStarted or not canJoinPrivate() then
        return
    end

    privateJoinStarted = true

    task.spawn(function()
        local joinSuccess, joinError = pcall(function()
            assert(type(Config.FriendName) == "string" and Config.FriendName ~= "", "Set Config.FriendName at the top")
            assert(Config.FriendName:lower() ~= LocalPlayer.Name:lower(), "FriendName must be another player")

            local cam = ReplicatedStorage:WaitForChild("CAM")
            local Teleporter = require(
                cam:WaitForChild("Client")
                    :WaitForChild("Modules")
                    :WaitForChild("Teleporter")
            )

            local VipAccess = require(
                cam:WaitForChild("Global"):WaitForChild("VipAccess")
            )

            if not canJoinPrivate() then
                return
            end

            local function joinPrivate(ownerName, subtitle)
                if not canJoinPrivate() then
                    return false, "Cancelled"
                end

                return Teleporter.Request({
                    placeId = game.PlaceId,
                    privateOwner = ownerName,
                }, {
                    Title = "Joining Private Server",
                    SubTitle = subtitle,
                })
            end

            local ownReason = "Private-server access is not owned"

            if VipAccess.Has(LocalPlayer) then
                local joinedOwn
                joinedOwn, ownReason = joinPrivate(
                    LocalPlayer.Name,
                    "Trying your private server"
                )

                if not canJoinPrivate() then
                    return
                end

                if joinedOwn then
                    return
                elseif ownReason == "Busy" then
                    warn("Another teleport request is already running")
                    return
                end
            end

            if not canJoinPrivate() then
                return
            end

            local joinedFriend, friendReason = joinPrivate(
                Config.FriendName,
                "Trying " .. Config.FriendName .. "'s private server"
            )

            if not joinedFriend and canJoinPrivate() then
                warn(
                    "Both private-server attempts failed.",
                    "Own:", ownReason,
                    "Friend:", friendReason
                )
            end
        end)

        if not joinSuccess and not versionKickRequested and not triggered then
            warn("Private-server join failed:", joinError)
        end
    end)
end

