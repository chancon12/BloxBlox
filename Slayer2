        local owner
        if isInConfiguredFriendServer() then
            owner = Config.FriendName
        elseif isCurrentPrivateServer(privateRoute.Current) then
            owner = privateRoute.Current.Owner
        end

        local serverName = type(owner) == "string" and owner ~= ""
            and (owner .. " Private Server") or "Current Server (owner unknown)"
        local maximum = tonumber(Players.MaxPlayers) or 0
        local maximumText = maximum > 0 and tostring(math.floor(maximum)) or "?"
        serverLabel.Text = string.format(
