    	Visible = false,
    	ZIndex = 200,
    }, screenGui)

    addCorner(openButton, 18)
    addStroke(openButton, COLORS.Gold, 2, 0.05)
    addTextConstraint(openButton, 16, 26)

    local function setOpen(isOpen)
    	overlay.Visible = isOpen
    	openButton.Visible = not isOpen
    end

    closeButton.MouseButton1Click:Connect(function()
    	setOpen(false)
    end)

    openButton.MouseButton1Click:Connect(function()
    	setOpen(true)
    end)

    local function showWaiting()
    	title.Text = targetName .. " - Loading..."

    	for index, itemConfig in ipairs(CONFIG.Items) do
    		itemLabels[index].Text = itemConfig.Name .. " - x0"
    	end

    	wenLabel.Text = "Wen - 0"
    end

    local function refresh()
    	local profile = findProfile()
    	local slot = getActiveSlot(profile)

    	if not profile or not slot then
    		showWaiting()
    		return
    	end

    	title.Text = targetName .. " - Level " .. formatNumber(readLevel(slot))

    	for index, itemConfig in ipairs(CONFIG.Items) do
    		local total = readItemTotal(slot, itemConfig.Name)
    		itemLabels[index].Text = itemConfig.Name .. " - x" .. formatNumber(total)
    	end

    	local wen = slot:FindFirstChild("Wen")
    	wenLabel.Text = "Wen - " .. formatNumber(wen and wen.Value or 0)
    end

    showWaiting()

    task.spawn(function()
    	while screenGui.Parent do
    		local ok, message = pcall(refresh)

    		if not ok then
    			warn("AFK Resource Monitor refresh failed:", message)
    		end

    		task.wait(math.max(CONFIG.RefreshSeconds, 0.1))
    	end
    end)

    local rightControlHeld = false

    local function sendRightControl(isPressed)
    	local ok, message = pcall(function()
    		local virtualInputManager = game:GetService("VirtualInputManager")
    		virtualInputManager:SendKeyEvent(
    			isPressed,
    			Enum.KeyCode.RightControl,
    			false,
    			game
    		)
    	end)

    	if ok then
    		rightControlHeld = isPressed
    	else
    		warn("AFK Resource Monitor could not send RightControl input:", message)
    	end

    	return ok
    end


    screenGui.Destroying:Connect(function()
    	if rightControlHeld then
    		sendRightControl(false)
    	end
    end)

    task.delay(math.max(CONFIG.RightControlHoldDelay, 0), function()
    	if screenGui.Parent then
    		sendRightControl(true)
    	end
    end)
end

if game.PlaceId == VERSION_PLACE_ID then
    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        local versionGui = playerGui:WaitForChild("Version")
        versionLabel = versionGui:WaitForChild("Label")

        local function checkVersion()
            if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
                return
            end

            local currentVersion = tonumber(versionLabel.Text)

            -- Wait for the game's displayed version to load.
            if currentVersion == nil then
                return
            end

            if currentVersion == Config.ExpectedVersion then
                startPrivateJoin()
                return
            end

            -- Disable freezing BEFORE kicking for a version mismatch.
            versionKickRequested = true

            if disconnectConnection then
                disconnectConnection:Disconnect()
                disconnectConnection = nil
            end

            LocalPlayer:Kick("Version change, recheck again.")
        end

        versionLabel:GetPropertyChangedSignal("Text"):Connect(checkVersion)
        checkVersion()
    end)
elseif game.PlaceId == AFK_PLACE_ID then
    -- Run the attached monitor here without another private-server join.
    task.spawn(startAFKResourceMonitor)
else
    -- Other places keep the existing disconnect rules without a version gate.
    startPrivateJoin()
end
