-- Private Server Control GUI
-- Run from a client context. Server-side owner/moderator checks still apply.

local MAIN_PLACE_ID = 16205713724
local PRIVATE_SERVER_PLACE_ID = 136406881576517

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
assert(LocalPlayer, "Run this script on the client")

if game.PlaceId == MAIN_PLACE_ID then
	-- Only request your own private server from the main place.
	local ok, message = pcall(function()
		local cam = ReplicatedStorage:WaitForChild("CAM")
		local Teleporter = require(
			cam:WaitForChild("Client")
				:WaitForChild("Modules")
				:WaitForChild("Teleporter")
		)
		local VipAccess = require(
			cam:WaitForChild("Global"):WaitForChild("VipAccess")
		)

		if not VipAccess.Has(LocalPlayer) then
			warn("[PrivateServerControl] Private-server access is not owned.")
			return
		end

		local accepted, reason = Teleporter.Request({
			placeId = PRIVATE_SERVER_PLACE_ID,
			privateOwner = LocalPlayer.Name,
		}, {
			Title = "Joining Private Server",
			SubTitle = "Joining your private server",
		})

		if not accepted then
			warn("[PrivateServerControl] Own private-server request failed:", reason)
		end
	end)

	if not ok then
		warn("[PrivateServerControl] Own private-server join failed:", message)
	end
	return
elseif game.PlaceId ~= PRIVATE_SERVER_PLACE_ID then
	return
end

