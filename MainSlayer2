	PvpButton.BackgroundColor3 = pvpEnabled and COLORS.PvpOn or COLORS.PvpOff
end

workspace:GetAttributeChangedSignal("ServerPvP"):Connect(function()
	pvpEnabled = workspace:GetAttribute("ServerPvP") ~= false
	refreshPvpButton()
end)

PvpButton.MouseButton1Click:Connect(function()
	local requestedState = not pvpEnabled
	local stateWord = requestedState and "on" or "off"

	runCommand("/pvp " .. stateWord, function(success, message)
		if success then
			pvpEnabled = requestedState
			refreshPvpButton()
			setFeedback("Player PvP turned " .. string.upper(stateWord) .. ". " .. message, "Success")
		else
			setFeedback(message, "Error")
		end
	end)
end)

