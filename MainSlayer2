local busy = false
local activeMode = nil
local accessButtons = {}

local function setFeedback(text, kind)
	Feedback.Text = text or ""
	Feedback.TextColor3 = kind == "Success" and COLORS.Success
		or kind == "Error" and COLORS.Error
		or COLORS.Muted
end

local function runCommand(commandLine, callback)
	if busy then
		setFeedback("Please wait for the current command.", "Error")
		return
	end

	busy = true
	setFeedback("Sending " .. commandLine .. "...", "Normal")

	task.spawn(function()
		local reachedServer, commandSucceeded, serverMessage =
			pcall(SignalFunction.ToServer, "PlayerCommands", {
				action = "run",
				line = commandLine,
			})

		busy = false

		if not reachedServer then
			callback(false, "Could not reach the server.")
			return
		end

		local succeeded = commandSucceeded == true
		local message = serverMessage
		if message == nil or message == "" then
			message = succeeded and "Command completed." or "Command was denied."
		end

		callback(succeeded, tostring(message))
	end)
end

local function refreshAccessButtons()
	for mode, information in pairs(accessButtons) do
		local selected = mode == activeMode
		information.Button.BackgroundColor3 = selected and COLORS.Gold or COLORS.Button
		information.Button.TextColor3 = selected and Color3.fromRGB(28, 22, 12) or COLORS.Text
		information.Stroke.Color = selected and COLORS.GoldBright or COLORS.Gold
		information.Stroke.Thickness = selected and 2 or 1.2
	end
end

local accessDefinitions = {
	{ Mode = "Closed", X = 40 },
	{ Mode = "Friends", X = 236 },
	{ Mode = "Everyone", X = 432 },
}

for _, definition in ipairs(accessDefinitions) do
	local mode = definition.Mode
	local button = create("TextButton", {
		Name = mode,
		Position = UDim2.fromOffset(definition.X, 181),
		Size = UDim2.fromOffset(178, 59),
		BackgroundColor3 = COLORS.Button,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = string.upper(mode),
		TextColor3 = COLORS.Text,
		TextSize = 18,
		ZIndex = 12,
	}, Panel)
	addCorner(button, 11)
	local stroke = addStroke(button, COLORS.Gold, 1.2, 0.1)
	accessButtons[mode] = { Button = button, Stroke = stroke }

	button.MouseEnter:Connect(function()
		if activeMode ~= mode then
			button.BackgroundColor3 = COLORS.ButtonHover
		end
	end)

	button.MouseLeave:Connect(refreshAccessButtons)
	button.MouseButton1Click:Connect(function()
		runCommand("/access " .. string.lower(mode), function(success, message)
			if success then
				activeMode = mode
				AccessStatus.Text = "Access: " .. mode
				refreshAccessButtons()
				setFeedback(message, "Success")
			else
				setFeedback(message, "Error")
			end
		end)
	end)
end

