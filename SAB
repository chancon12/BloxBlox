    -- Existing game-rendered ownership indicator; never infer ownership by distance/name.
    -- PlotClient physical Source 1399-1405 sets YourBase.Enabled only for LocalPlayer.
    local function findOwnPlot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil, nil, "Plots are not loaded" end
        local found, indicator, matches = nil, nil, 0
        for _, plot in ipairs(plots:GetChildren()) do
            if plot:IsA("Model") then
                local sign = plot:FindFirstChild("PlotSign")
                local marker = sign and sign:FindFirstChild("YourBase")
                if marker and marker:IsA("BillboardGui") and marker.Enabled then
                    found, indicator, matches = plot, marker, matches + 1
                end
            end
        end
        if matches ~= 1 then return nil, nil, "Own-plot indicator is missing or ambiguous" end
        if found:GetAttribute("Loaded") ~= true then return nil, nil, "Own plot is still loading" end
        return found, indicator, nil
    end

    local promptStates = {
        None = true, Sell = true, Grab = true, Place = true,
        Return = true, Open = true, Steal = true,
    }
    local rarityByDisplay = {}
    for _, info in pairs(animalCatalogue) do
        local previousRarity = rarityByDisplay[info.Name]
        if previousRarity == nil then
            rarityByDisplay[info.Name] = info.Rarity
        elseif previousRarity ~= info.Rarity then
            rarityByDisplay[info.Name] = false
        end
    end

    local function countPlotBlocks(purchases)
        if not purchases or not purchases:IsA("Folder") then return nil end
        local count = 0
        for _, child in ipairs(purchases:GetChildren()) do
            if child:IsA("Model") and child.Name == "PlotBlock" then
                count = count + 1
            end
        end
        return count
    end

    local function readLoadedPlot()
        if replicatedFirst:GetAttribute("DataLoaded") ~= true then
            return nil, "Player data is not ready"
        end
        local plot, marker, reason = findOwnPlot()
        if not plot then return nil, reason end
        local tier = plot:GetAttribute("Tier")
        local config = type(tier) == "number" and tier % 1 == 0 and baseCatalogue[tier] or nil
        local result = {Rows = {}, Count = nil, ObservedModels = 0, Partial = true}

        -- Each supplied base template has one direct Purchases.PlotBlock Model per floor.
        -- Count duplicate sibling names; Tier only checks that all expected blocks are loaded.
        local purchases = plot:FindFirstChild("Purchases")
        local floorCount = countPlotBlocks(purchases)
        if config and floorCount == config.Floors then
            result.Floors = floorCount
        end

        local podiums = plot:FindFirstChild("AnimalPodiums")
        local slots, slotCount, slotBad = {}, 0, false
        if podiums and podiums:IsA("Folder") then
            for _, child in ipairs(podiums:GetChildren()) do
                if child:IsA("Model") then
                    local index = tonumber(child.Name)
                    if not index or index % 1 ~= 0 or index < 1
                        or tostring(index) ~= child.Name or slots[index] then
                        slotBad = true
                    else
                        slots[index], slotCount = child, slotCount + 1
                    end
                end
            end
        else
            slotBad = true
        end
        local topologyReady = config ~= nil and not slotBad and slotCount == config.Slots
        if config then
            for index = 1, config.Slots do
                local podium = slots[index]
                local base = podium and podium:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                if not spawn or not spawn:IsA("BasePart") then topologyReady = false end
            end
        end
        -- Templates contain inactive podiums. Require the reviewed Tier and a complete
        -- matching numbered-podium structure instead of counting arbitrary models.
        if topologyReady then result.Capacity = config.Slots end
        if plot:GetAttribute("Nuked") then
            local samePlot, sameMarker = findOwnPlot()
            if samePlot ~= plot or sameMarker ~= marker or plot:GetAttribute("Tier") ~= tier
                or plot:FindFirstChild("AnimalPodiums") ~= podiums
                or plot:FindFirstChild("Purchases") ~= purchases
                or countPlotBlocks(purchases) ~= floorCount
                or replicatedFirst:GetAttribute("DataLoaded") ~= true then
                return nil, "Own plot changed during collection"
            end
            result.Reason = "Plot display is temporarily unavailable"
            return result, nil
        end

        -- Read existing prompts only. Never activate them or connect their events.
        -- AnimalPrompt Source 25-36 supplies ObjectText even when State is None/busy.
        local promptCounts, occupied, coverageReady = {}, 0, topologyReady
        for _, podium in pairs(slots) do
            if podium:GetAttribute("DeferDisplay") then coverageReady = false end
            local base = podium:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            local attachment = spawn and spawn:FindFirstChild("PromptAttachment")
            local promptCount, configured, names, nameCount = 0, 0, {}, 0
            if attachment and attachment:IsA("Attachment") then
                for _, prompt in ipairs(attachment:GetChildren()) do
                    if prompt:IsA("ProximityPrompt") then
                        promptCount = promptCount + 1
                        local stateName = prompt:GetAttribute("State")
                        if type(stateName) == "string" and promptStates[stateName] then
                            configured = configured + 1
                            local text = prompt.ObjectText
                            if type(text) == "string" and text:find("%S") and not names[text] then
                                names[text], nameCount = true, nameCount + 1
                            end
                        end
                    end
                end
            end
            if promptCount ~= 2 or configured ~= 2 or nameCount > 1 then coverageReady = false end
            if nameCount == 1 and not podium:GetAttribute("DeferDisplay") then
                for name in pairs(names) do
                    promptCounts[name] = (promptCounts[name] or 0) + 1
                    occupied = occupied + 1
                end
            end
        end

        local groups, modelCounts = {}, {}
        local function addRow(identity, name, rarity, mutation, source, amount)
            local key = source .. ":" .. #identity .. ":" .. identity
                .. (mutation and ":M" .. #mutation .. ":" .. mutation or ":U")
            local group = groups[key]
            if not group then
                group = {Count = 0, Name = name, Rarity = rarity, Mutation = mutation, Source = source}
                groups[key] = group
            end
            group.Count = group.Count + amount
        end
        -- PlotClient Source 136-184 clones by Index, parents directly to PlotModel,
        -- and writes Mutation. Never match detached overhead GUIs by proximity.
        for _, child in ipairs(plot:GetChildren()) do
            local info = child:IsA("Model") and animalCatalogue[child.Name] or nil
            if info then
                local mutation = child:GetAttribute("Mutation")
                local fallback = child:GetAttribute("__mutation")
                if type(mutation) ~= "string" or mutation == "" then mutation = nil end
                if type(fallback) ~= "string" or fallback == "" then fallback = nil end
                local rowSource = "model"
                if mutation and fallback and mutation ~= fallback then
                    mutation, rowSource = nil, "model-unknown"
                elseif not mutation then
                    mutation = fallback
                end
                addRow(child.Name, info.Name, info.Rarity, mutation, rowSource, 1)
                modelCounts[info.Name] = (modelCounts[info.Name] or 0) + 1
                result.ObservedModels = result.ObservedModels + 1
            end
        end

        -- Models load asynchronously. Fully configured podium prompts can fill name-only
        -- gaps, but they cannot supply mutations for a model that has not appeared.
        for name, count in pairs(modelCounts) do
            if count > (promptCounts[name] or 0) then coverageReady = false end
        end
        if coverageReady then
            for name, count in pairs(promptCounts) do
                local missing = count - (modelCounts[name] or 0)
                if missing > 0 then
                    addRow(name, name, rarityByDisplay[name] or nil, nil, "prompt", missing)
                end
            end
            result.Count, result.Partial = occupied, false
        end

        for _, group in pairs(groups) do
            local parts = {group.Name}
            if group.Rarity then table.insert(parts, group.Rarity) end
            if group.Mutation then
                table.insert(parts, "Mutation: " .. group.Mutation)
            end
            table.insert(result.Rows, "x" .. exact(group.Count) .. " " .. table.concat(parts, " | "))
        end
        table.sort(result.Rows)

        if result.Partial then result.Reason = "Podium/model data is incomplete or inconsistent" end
        local samePlot, sameMarker = findOwnPlot()
        if samePlot ~= plot or sameMarker ~= marker or plot:GetAttribute("Tier") ~= tier
            or plot:FindFirstChild("AnimalPodiums") ~= podiums
                or plot:FindFirstChild("Purchases") ~= purchases
                or countPlotBlocks(purchases) ~= floorCount
            or replicatedFirst:GetAttribute("DataLoaded") ~= true then
            return nil, "Own plot changed during collection"
        end
        return result, nil
    end

