    local function displayedAmount(text)
        -- Remove an existing dollar prefix only; never expand a formatted suffix.
        local amount = text:match("^%s*(.-)%s*$")
        return (amount:gsub("^%$%s*", ""))
    end

    local function collect()
        local player = players.LocalPlayer
        assert(player, "LocalPlayer is not available.")
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        local dataLoaded = replicatedFirst:GetAttribute("DataLoaded")
        local backpackReady = character and character:GetAttribute("BackpackReady")
        local plotOK, plotSnapshot, plotReason = pcall(readLoadedPlot)
        if not plotOK then plotReason, plotSnapshot = tostring(plotSnapshot), nil end
        local issue = plotReason or (plotSnapshot and plotSnapshot.Reason)
        if issue and issue ~= lastPlotIssue then
            warn("SAB_LOCALHOST: Loaded plot view: " .. issue)
        end
        lastPlotIssue = issue

        local rebirthStat = readLeaderstat(player, "Rebirths")
        local rebirthTitle, rebirthDetails = "? Rebirths", "Unavailable"
        if rebirthStat then
            if rebirthStat.Kind == "number" then
                local value = rebirthStat.Value
                assert(value >= 0 and value % 1 == 0, "Rebirth count is not a nonnegative integer.")
                rebirthTitle = countLabel(value, "Rebirth", "Rebirths")
                rebirthDetails = exact(value)
            else
                rebirthDetails = rebirthStat.Text
                rebirthTitle = rebirthDetails .. (rebirthDetails == "1" and " Rebirth" or " Rebirths")
            end
        end

        local cashStat = readLeaderstat(player, "Cash")
        local cashTitle, cashDetails = "?", "Unavailable"
        if cashStat and cashStat.Kind == "number" then
            assert(cashStat.Value >= 0, "Cash is negative; report discarded.")
            cashTitle = compact(cashStat.Value)
            cashDetails = "$" .. exact(cashStat.Value)
        elseif cashStat then
            local amount = displayedAmount(cashStat.Text)
            assert(amount ~= "", "Cash text has no amount; report discarded.")
            cashTitle = amount
            cashDetails = "$" .. amount
        elseif dataLoaded == true then
            local text = readCashText(player)
            if text then
                local amount = displayedAmount(text)
                if amount ~= "" then
                    cashTitle = amount
                    cashDetails = "$" .. amount
                end
            end
        end

        -- The listing's Weapons & Gear category counts currently replicated Tool instances.
        local toolCount, toolLines
        if dataLoaded == true and character and character.Parent == workspace
            and character:FindFirstChild("Humanoid") and backpack and backpackReady then
            local counts, seen = {}, {}
            toolCount, toolLines = 0, {}
            local function scan(container)
                for _, tool in ipairs(container:GetChildren()) do
                    if tool:IsA("Tool") and not seen[tool] then
                        seen[tool] = true
                        counts[tool.Name] = (counts[tool.Name] or 0) + 1
                        toolCount = toolCount + 1
                    end
                end
            end
            scan(backpack)
            scan(character)
            assert(player.Character == character and character.Parent == workspace
                and backpack.Parent == player and player:FindFirstChildOfClass("Backpack") == backpack
                and character:GetAttribute("BackpackReady")
                and replicatedFirst:GetAttribute("DataLoaded") == true,
                "Tool readiness changed during collection; report discarded.")
            for name, count in pairs(counts) do
                table.insert(toolLines, "x" .. exact(count) .. " " .. name)
            end
            table.sort(toolLines)
        end

        local toolTitle = toolCount ~= nil and countLabel(toolCount, "Weapon", "Weapons") or "? Weapons"
        local toolDetails = "Unavailable"
        if toolLines then
            toolDetails = #toolLines > 0 and table.concat(toolLines, ", ") or "None"
        end
        local floors = plotSnapshot and plotSnapshot.Floors
        local capacity = plotSnapshot and plotSnapshot.Capacity
        local brainrotCount = plotSnapshot and plotSnapshot.Count
        local floorTitle = floors and countLabel(floors, "Floor", "Floors") or "? Floors"
        local brainrotTitle = brainrotCount ~= nil and countLabel(brainrotCount, "Brainrot", "Brainrots") or "? Brainrots"
        local slotsText = capacity and ((brainrotCount ~= nil and exact(brainrotCount) or "?") .. " / " .. exact(capacity)) or "Unavailable"
        local title = "🔥【Steal a Brainrot】🔄 " .. rebirthTitle
            .. " | 🏢 " .. floorTitle
            .. " | ⚔️ " .. toolTitle
            .. " | 🧠 " .. brainrotTitle
            .. " | 💰 " .. cashTitle
        local lines = {
            title,
            "",
            "📋 Account Details",
            "🔄 Rebirths: " .. rebirthDetails,
            "🏢 Floors: " .. (floors and exact(floors) or "Unavailable"),
            "🎒 Brainrot Slots: " .. slotsText,
            "💰 Cash: " .. cashDetails,
            "⚔️ Weapons & Gear: " .. toolDetails,
            "",
            "🧠 Owned Brainrots",
        }
        if not plotSnapshot or plotSnapshot.Partial then
            table.insert(lines, "Unavailable")
        elseif #plotSnapshot.Rows > 0 then
            for _, row in ipairs(plotSnapshot.Rows) do table.insert(lines, row) end
        elseif brainrotCount == 0 then
            table.insert(lines, "None")
        else
            table.insert(lines, "Unavailable")
        end
        table.insert(lines, "")
        for _, line in ipairs(sellerFooter) do table.insert(lines, line) end
        return player.Name, table.concat(lines, "\n")
    end

    local function sendLatest(username, description)
        if not current() then return "stopped" end
        -- Reuse the original request marker so a rerun waits for an earlier request.
        if state.inFlight then return "pending" end
        local changed = state.lastSuccessfulEndpoint ~= endpoint
            or state.lastSuccessfulUser ~= username
            or state.lastSuccessfulDescription ~= description
        if not changed and state.retryNeeded ~= true then return "unchanged" end
        if os.clock() - state.lastAttemptAt < interval then return "throttled" end
        if not current() then return "stopped" end

        local owner = {}
        state.inFlight = owner
        state.lastAttemptAt = os.clock()
        state.retryNeeded = true
        local stage = "JSON encoding"
        local status
        local sent, response = pcall(function()
            local encoded = jsonService:JSONEncode({username = username, description = description})
            stage = "HTTP transport selection"
            local transport = type(request) == "function" and request
                or type(http_request) == "function" and http_request
                or type(syn) == "table" and type(syn.request) == "function" and syn.request
                or type(http) == "table" and type(http.request) == "function" and http.request
            assert(type(transport) == "function", "No supported runner HTTP request function is available.")
            stage = "HTTP PUT"
            local result = transport({
                Url = endpoint,
                Method = "PUT",
                Headers = {["Content-Type"] = "application/json"},
                Body = encoded,
            })
            stage = "HTTP response"
            if type(result) == "table" then
                status = tonumber(result.StatusCode or result.Status or result.status_code)
            end
            return result
        end)
        local success = sent and type(response) == "table" and status ~= nil
            and status >= 200 and status <= 299 and response.Success ~= false

        -- Record the request's actual result even when this worker retired while waiting.
        -- A newer worker can then send its own latest snapshot after the marker clears.
        if state.inFlight == owner then
            if success then
                state.lastSuccessfulEndpoint = endpoint
                state.lastSuccessfulUser = username
                state.lastSuccessfulDescription = description
                state.retryNeeded = false
            end
            state.inFlight = nil
        end
        if success then return "sent", "HTTP " .. tostring(status) end
        if not sent then return "failed", stage .. ": " .. tostring(response) end
        if type(response) ~= "table" then
            return "failed", "Runner returned an unexpected HTTP response."
        end
        return "failed", "HTTP " .. tostring(status) .. " | "
            .. tostring(response.StatusMessage or response.Message or "Request was not accepted")
    end

    task.spawn(function()
        if not current() then return end
        print("SAB_LOCALHOST: Started. Reading existing leaderstats, Tools and your loaded plot display without game-module access. PUTting changes to localhost every 30 seconds.")
        local lastUser, lastDescription, lastError, lastSendStatus
        while current() do
            local cycleStart = os.clock()
            local ok, userOrError, description = pcall(collect)
            if not current() then return end
            if ok then
                if lastUser ~= userOrError or lastDescription ~= description or lastError ~= nil then
                    print(description)
                    lastUser, lastDescription = userOrError, description
                end
                lastError = nil
                local outcome, detail = sendLatest(userOrError, description)
                if not current() then return end
                if outcome == "sent" then
                    print("SAB_LOCALHOST: Description sent to localhost. " .. detail)
                elseif outcome == "failed" then
                    warn("SAB_LOCALHOST: Send failed; the latest snapshot will retry after the interval. " .. detail)
                elseif outcome == "pending" and lastSendStatus ~= "pending" then
                    print("SAB_LOCALHOST: Waiting for an earlier HTTP request to finish.")
                end
                lastSendStatus = outcome
            else
                local message = tostring(userOrError)
                if lastError ~= message then
                    warn("SAB_LOCALHOST: " .. message .. " Will retry after the interval.")
                    lastError = message
                end
            end
            while current() and os.clock() - cycleStart < interval do
                task.wait(0.25)
            end
        end
    end)
end
