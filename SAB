    local function readCashText(player)
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if not playerGui then return nil, "PlayerGui is unavailable" end
        local object = playerGui
        local path = "PlayerGui"
        for _, name in ipairs({"LeftBottom", "LeftBottom", "Currency"}) do
            path = path .. "." .. name
            object = object:FindFirstChild(name)
            if not object then return nil, "missing " .. path end
        end
        if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
            return nil, "Currency is not a supported text UI object"
        end
        local text = object.Text
        if type(text) ~= "string" or not text:find("%S") then
            return nil, "Currency text is empty"
        end
        if player:FindFirstChildOfClass("PlayerGui") ~= playerGui
            or not object:IsDescendantOf(playerGui) or object.Text ~= text then
            return nil, "cash UI changed during collection"
        end
        return text, nil
    end

    local function readLeaderstat(player, name)
        local folder = player:FindFirstChild("leaderstats")
        if not folder then return nil, "leaderstats is unavailable" end
        if not folder:IsA("Folder") then return nil, "leaderstats is not a Folder" end
        local stat = folder:FindFirstChild(name)
        if not stat then return nil, "leaderstats." .. name .. " is unavailable" end
        local text, kind, rawValue
        if stat:IsA("IntValue") or stat:IsA("NumberValue") then
            local value = stat.Value
            if type(value) ~= "number" or value ~= value or value <= -math.huge or value >= math.huge then
                return nil, "leaderstats." .. name .. " is not a finite numeric value"
            end
            text, kind, rawValue = string.format("%.17g", value), "number", value
        elseif stat:IsA("StringValue") then
            text, kind = stat.Value, "string"
            rawValue = text
            if not text:find("%S") then return nil, "leaderstats." .. name .. " is empty" end
        else
            return nil, "leaderstats." .. name .. " has unsupported class " .. stat.ClassName
        end
        if player:FindFirstChild("leaderstats") ~= folder or folder.Parent ~= player
            or folder:FindFirstChild(name) ~= stat or stat.Parent ~= folder then
            return nil, "leaderstats changed during collection"
        end
        return {Text = text, Kind = kind, Value = rawValue, ClassName = stat.ClassName}, nil
    end

    local function exact(value)
        assert(type(value) == "number" and value == value
            and value >= 0 and value < math.huge, "Invalid numeric data.")
        local text = value % 1 == 0 and string.format("%.0f", value)
            or string.format("%.17g", value)
        local mantissa, exponent = text:match("^([^eE]+)[eE]([%+%-]?%d+)$")
        if mantissa then
            local whole, fraction = mantissa:match("^(%d+)%.?(%d*)$")
            local digits = whole .. fraction
            local point = #whole + tonumber(exponent)
            if point <= 0 then
                text = "0." .. string.rep("0", -point) .. digits
            elseif point >= #digits then
                text = digits .. string.rep("0", point - #digits)
            else
                text = digits:sub(1, point) .. "." .. digits:sub(point + 1)
            end
        end
        local whole, fraction = text:match("^(%d+)%.?(%d*)$")
        assert(whole, "Cannot format numeric data.")
        whole = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        fraction = fraction:gsub("0+$", "")
        return whole .. (fraction ~= "" and "." .. fraction or "")
    end

    -- Truncate compact currency by slicing its integer digits.
    local function compact(value)
        local integer = exact(value):match("^[%d,]+"):gsub(",", "")
        if #integer <= 3 then return integer end
        local suffixes = {"K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
        local tier = math.min(math.floor((#integer - 1) / 3), #suffixes)
        local leading = #integer - tier * 3
        local tenths = integer:sub(leading + 1, leading + 1)
        return integer:sub(1, leading)
            .. (tenths ~= "" and tenths ~= "0" and "." .. tenths or "")
            .. suffixes[tier]
    end

    local function countLabel(count, singular, plural)
        return compact(count) .. " " .. (count == 1 and singular or plural)
    end

