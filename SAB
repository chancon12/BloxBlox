    local environment = type(getgenv) == "function" and getgenv() or _G
    local registryKey = "__StealABrainrotAccountApiChecker_v1"
    local state = rawget(environment, registryKey)
    if type(state) ~= "table" then
        state = {generation = 0}
        rawset(environment, registryKey, state)
    end
    local previous = state.generation
    if type(previous) ~= "number" or previous ~= previous
        or previous < 0 or previous >= math.huge then
        previous = 0
    end
    state.generation = previous + 1
    local generation = state.generation
    local interval = 30
    local endpoint = "http://localhost:3030/api/accounts/description"
    local attemptAt = state.lastAttemptAt
    if type(attemptAt) ~= "number" or attemptAt ~= attemptAt or attemptAt > os.clock() then
        state.lastAttemptAt = -math.huge
    end
    if state.inFlight ~= nil and type(state.inFlight) ~= "table" then
        state.inFlight = nil
    end
    local function current()
        return state.generation == generation
    end
    state.Stop = function()
        if current() then state.generation = state.generation + 1 end
    end

