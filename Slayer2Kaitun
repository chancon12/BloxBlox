    return string.format("%s\n%s - %d/%s%s", workflowStatusText,
        serverName, playerCount, maximumText, loaderText)
end

-- Slayer progression starts only after entering the farming world.
local function startSlayerProgression()
    local Config = environment.Configs

    local function enforceHumanOnly()
        if Config.Progression.HumanOnly ~= true then return end
        Config.Progression.AutoLearnDemonArt = false
        Config.RandomStart.Breathing = true
        Config.RandomStart.DemonArt = false
        Config.DemonArt.Enabled = false
        Config.DemonArt.UseOrb = false
        Config.DemonArt.SpinFallback = false
        Config.DemonArt.AutoUnlockSkills = false
        Config.Muzan.Enabled = false
        Config.MuzanQuestline.Enabled = false
    end

    enforceHumanOnly()

    local function ApplyRandomStart(config)
    	local options = config.RandomStart
    	if not options or options.Enabled ~= true then return end
    	if options.Breathing == true and options.DemonArt == true then
    		warn("[RandomStart] Enable only Breathing or DemonArt; manual settings kept.")
    		return
    	end
    	local random = Random.new()
    	local useBreathing
    	if options.Breathing == true then
    		useBreathing = true
    	elseif options.DemonArt == true then
    		useBreathing = false
    	else
    		useBreathing = random:NextInteger(1, 2) == 1
    	end
    	local names = useBreathing and options.BreathingNames or options.DemonArtNames
    	if type(names) ~= "table" or #names == 0 then
    		warn("[RandomStart] The selected path needs at least one name; manual settings kept.")
    		return
    	end
    	local selectedName = names[random:NextInteger(1, #names)]
    	if useBreathing then
    		config.Breathing.Selected = selectedName
    	else
    		config.DemonArt.Orb = selectedName
    	end
    	config.Breathing.AutoLearn = useBreathing
    	config.DemonArt.Enabled = not useBreathing
    end

    ApplyRandomStart(Config)

    local function StartProgressionController()
    	if Config.Progression.Enabled ~= true then
    		setWorkflowStatus("Slayer autoprogression disabled")
    		return
    	end
    	local Players = game:GetService("Players")
    	local ReplicatedStorage = game:GetService("ReplicatedStorage")
    	local HttpService = game:GetService("HttpService")

    	-- Remember the chosen path once; do not reroll it on every check.
    	local requested = {
    		Breathing = Config.Progression.HumanOnly == true or Config.Breathing.AutoLearn == true,
    		DemonArt = Config.DemonArt.Enabled == true,
    		UseOrb = Config.DemonArt.UseOrb == true,
    		SpinFallback = Config.DemonArt.SpinFallback == true
    	}
    	local state = {Running = true, Kicked = false}
    	environment.__DemonSlayerProgressionController = state
    	local expPerLevel
    	local descriptionState = {Busy = false, LastAttempt = -math.huge}
    	local skillModules = {NextTry = 0}

    	local function status(message)
    		if state.Status ~= message then
    			state.Status = message
    			print("[Progression] " .. message)
    			setWorkflowStatus(message)
    		end
    	end

    	local function clean(value)
    		local name = tostring(value or ""):match("^%s*(.-)%s*$")
    		local lower = name:lower()
    		if lower == "" or lower == "none" or lower == "nil"
    			or lower == "null" or lower == "n/a" then
    			return ""
    		end
    		return name
    	end

    	local function styleKey(name)
    		local key = clean(name):lower()
    		if key == "thunder" then return "lightning" end
    		if key == "pyrokinesis" then return "pyrokenesis" end
    		return key
    	end

    	local function setBosses(bossNames)
    		local selected = Config.Bosses.Selected
    		-- Preserve the table identity for loaders that keep a reference to it.
    		if type(selected) ~= "table" then
    			selected = {}
    			Config.Bosses.Selected = selected
    		end
    		local same = #selected == #bossNames
    		if same then
    			for index, name in ipairs(bossNames) do
    				if selected[index] ~= name then same = false; break end
    			end
    		end
    		if not same then
    			Config.Bosses.Enabled = false
    			for key in pairs(selected) do selected[key] = nil end
    			for index, name in ipairs(bossNames) do selected[index] = name end
    		end
    		Config.Bosses.Enabled = #bossNames > 0
    	end

    	local function setBoss(bossName)
    		setBosses(bossName and {bossName} or {})
    	end

    	local function pause()
    		Config.AutoFarm.Enabled = false
    		Config.BossHunt.Enabled = false
    		setBoss(nil)
    		Config.Breathing.AutoLearn = false
    		Config.DemonArt.Enabled = false
    		Config.DemonArt.UseOrb = false
    		Config.DemonArt.SpinFallback = false
    	end

    	local function findSlot(player)
    		local service = ReplicatedStorage:FindFirstChild("Player_Service")
    		local data = service and service:FindFirstChild("Data")
    		if not data then return nil end
    		for _, profile in ipairs(data:GetChildren()) do
    			if profile.Name:gsub("%-Studio$", ""):lower() == player.Name:lower() then
    				local equipped = profile:FindFirstChild("slotEquipped")
    				local slots = profile:FindFirstChild("slots")
    				if equipped and slots then
    					return slots:FindFirstChild("Slot" .. tostring(equipped.Value))
    				end
    				return nil
    			end
    		end
    	end

    	local function readLevel(slot)
    		local exp = slot:FindFirstChild("Exp")
    		local goal = exp and exp:FindFirstChild("Goal")
    		local value = goal and tonumber(goal.Value)
    		-- Missing/uninitialized data is unknown, not level zero.
    		if not value or value <= 0 or value ~= value or value == math.huge then
    			return nil
    		end
    		if not expPerLevel then
    			local cam = ReplicatedStorage:FindFirstChild("CAM")
    			local global = cam and cam:FindFirstChild("Global")
    			local settingsModule = global and global:FindFirstChild("gameSettings")
    			if not settingsModule then return nil end
    			local ok, settings = pcall(require, settingsModule)
    			local amount = ok and type(settings) == "table" and tonumber(settings.expPerLevel)
    			if amount and amount > 0 and amount < math.huge then
    				expPerLevel = amount
    			else
    				expPerLevel = 60 -- Same fallback as your resource monitor.
    				warn("[Progression] Could not read expPerLevel; using the monitor fallback of 60.")
    			end
    		end
    		return math.floor(value / expPerLevel)
    	end

    	local function readStyle(slot)
    		local race = slot:FindFirstChild("Race")
    		local raceName = race and clean(race.Value):lower() or ""
    		if raceName == "" then return nil, nil, nil end
    		local powers = slot:FindFirstChild("Powers")
    		local breathing = powers and powers:FindFirstChild("Breathing")
    		local demonArt = powers and powers:FindFirstChild("DemonArt")
        if Config.Progression.HumanOnly == true and raceName == "human" then
            if not breathing then return nil, nil, raceName end
            local name = clean(breathing.Value)
            return name, name ~= "" and "Breathing" or nil, raceName
        end
    		if raceName == "demon" then
    			-- A saved Breathing style does not mean this Demon owns a Demon Art.
    			if not demonArt then return nil, nil, raceName end
    			local name = clean(demonArt.Value)
    			return name, name ~= "" and "DemonArt" or nil, raceName
    		end
    		-- An absent value is still loading; a present value of None is empty.
    		if not breathing or not demonArt then return nil, nil, raceName end
    		local breathingName = clean(breathing.Value)
    		local demonArtName = clean(demonArt.Value)
    		if breathingName ~= "" then return breathingName, "Breathing", raceName end
    		return demonArtName, demonArtName ~= "" and "DemonArt" or nil, raceName
    	end

    	local function skillMoveLabel(skill)
    		local function asKey(value)
    			if value == nil then return nil end
    			local text = clean(tostring(value))
    			local key = text:match("^Enum%.KeyCode%.([%a])$") or text:match("^([%a])$")
    			return key and key:upper() or nil
    		end
    		local overrides = Config.AccountDescription.SkillKeyOverrides
    		local override = type(overrides) == "table" and asKey(overrides[skill.Name])
    		if override then return override end
    		for _, field in ipairs({"KeyCode", "Keybind", "KeyBind", "Key", "Bind", "Input"}) do
    			local key = asKey(skill[field])
    			if key then return key end
    		end
    		-- Use the actual skill name when the catalog does not expose its key.
    		return clean(skill.Name)
    	end

    	local function readAllSkillsStatus(player, slot, style, styleType)
    		if not style or style == "" or not styleType then return nil end
    		local catalogName = styleType == "DemonArt" and "DemonArts" or "Breathings"
    		if not skillModules.CharacterInfo or not skillModules[catalogName] then
    			if os.clock() < skillModules.NextTry then return nil end
    			skillModules.NextTry = os.clock() + 2
    			local cam = ReplicatedStorage:FindFirstChild("CAM")
    			local global = cam and cam:FindFirstChild("Global")
    			local powers = global and global:FindFirstChild("Powers")
    			local catalogModule = powers and powers:FindFirstChild(catalogName)
    			local infoModule = global and global:FindFirstChild("Character_info_provider")
    			if not catalogModule or not infoModule then return nil end
    			local okInfo, info = pcall(require, infoModule)
    			local okCatalog, catalog = pcall(require, catalogModule)
    			if not okInfo or type(info) ~= "table" or type(info.HasUnlockedSkills) ~= "function"
    				or not okCatalog or type(catalog) ~= "table" then
    				return nil
    			end
    			skillModules.CharacterInfo = info
    			skillModules[catalogName] = catalog
    			skillModules.NextTry = 0
    		end
    		local catalog = skillModules[catalogName]
    		local power = catalog[style]
    		if type(power) ~= "table" then
    			for name, definition in pairs(catalog) do
    				if type(name) == "string" and styleKey(name) == styleKey(style) then
    					power = definition
    					break
    				end
    			end
    		end
    		if type(power) ~= "table" or type(power.Skills) ~= "table" then return nil end
    		local skills, definitions = {}, {}
    		for _, skill in ipairs(power.Skills) do
    			if type(skill) == "table" and type(skill.Name) == "string"
    				and clean(skill.Name) ~= "" and clean(skill.Name):lower() ~= "blocking" then
    				skills[#skills + 1] = skill.Name
    				definitions[#definitions + 1] = skill
    			end
    		end
    		if #skills == 0 then return nil end -- An empty/loading catalog is not completion.
    		local ok, unlocked = pcall(skillModules.CharacterInfo.HasUnlockedSkills, player, skills)
    		if not ok or type(unlocked) ~= "boolean" or findSlot(player) ~= slot then return nil end
    		if unlocked then return true, {} end
    		local remaining = {}
    		for _, skill in ipairs(definitions) do
    			local okMove, moveUnlocked = pcall(
    				skillModules.CharacterInfo.HasUnlockedSkills, player, {skill.Name}
    			)
    			if not okMove or type(moveUnlocked) ~= "boolean" or findSlot(player) ~= slot then
    				return false, nil -- Keep progression's confirmed result; details are unavailable.
    			end
    			if not moveUnlocked then remaining[#remaining + 1] = skillMoveLabel(skill) end
    		end
    		if #remaining == 0 then return false, nil end -- Data changed during the read; retry next check.
    		return false, remaining
    	end

    	-- BEGIN CURRENT BREATHING SKILL UNLOCKER
    	-- Shared request state prevents this worker from overlapping itself on a rerun.
    	local unlockRegistryKey = "__SlayerBreathingSkillUnlock_v1"
    	local unlockState = rawget(environment, unlockRegistryKey)
    	if type(unlockState) ~= "table" then
    	    unlockState = {NextAttemptAt = 0}
    	    rawset(environment, unlockRegistryKey, unlockState)
    	end
    	local unlockModules
    	local nextUnlockModuleTry = 0

    	local function breathingUnlockRunning()
    	    return state.Running and not state.Kicked
    	        and Config.Progression.Enabled == true
    	        and environment.__DemonSlayerProgressionController == state
    	end

    	local function loadBreathingUnlockModules(isCurrent)
    	    if unlockModules then return unlockModules end
    	    if os.clock() < nextUnlockModuleTry then return nil end
    	    nextUnlockModuleTry = os.clock() + 5
    	    local loaded = {}
    	    local paths = {
    	        {"Breathings", {"CAM", "Global", "Powers", "Breathings"}},
    	        {"Stats", {"CAM", "Global", "SkillService", "Stats"}},
    	        {"Tree", {"CAM", "Global", "SkillService", "SkillTreeholder"}},
    	        {"Signal", {"Communication", "ServerAndClient", "Signals", "SignalFunction"}},
    	    }
    	    for _, entry in ipairs(paths) do
    	        local node = ReplicatedStorage
    	        for _, name in ipairs(entry[2]) do
    	            node = node:FindFirstChild(name)
    	            if not node then return nil end
    	        end
    	        if not node:IsA("ModuleScript") then return nil end
    	        loaded[entry[1]] = require(node)
    	        if not isCurrent() then return nil end
    	    end
    	    if type(loaded.Breathings) ~= "table"
    	        or type(loaded.Stats) ~= "table"
    	        or type(loaded.Stats.IsSkillUnlocked) ~= "function"
    	        or type(loaded.Stats.GetRequirements) ~= "function"
    	        or type(loaded.Stats.GetSkillInfoFor) ~= "function"
    	        or type(loaded.Stats.SourceCheck) ~= "function"
    	        or type(loaded.Tree) ~= "table"
    	        or type(loaded.Tree.RequirementsSolver) ~= "table"
    	        or type(loaded.Signal) ~= "table"
    	        or type(loaded.Signal.ToServer) ~= "function" then
    	        return nil
    	    end
    	    unlockModules = loaded
    	    return loaded
    	end

    	-- One request per call. The next move waits for the game's learned state.
    	local function unlockCurrentBreathingSkill()
    	    if not breathingUnlockRunning() or Config.Breathing.AutoUnlockSkills ~= true
    	        or not game:GetService("RunService"):IsClient() then return end
    	    if unlockState.InFlight or os.clock() < (unlockState.NextAttemptAt or 0) then return end

    	    local player = Players.LocalPlayer
    	    local slot = player and findSlot(player)
    	    if not slot then return end
    	    local style, styleType, race = readStyle(slot)
    	    if styleType ~= "Breathing" or not style or style == "" then return end
    	    if race ~= "human" and race ~= "slayer" and race ~= "hybrid" then return end
    	    if Config.Progression.HumanOnly == true and race ~= "human" then return end

    	    local function isCurrent()
    	        if not breathingUnlockRunning() or Config.Breathing.AutoUnlockSkills ~= true
    	            or Players.LocalPlayer ~= player or findSlot(player) ~= slot then return false end
    	        local currentStyle, currentType, currentRace = readStyle(slot)
    	        return currentStyle == style and currentType == styleType and currentRace == race
    	            and (Config.Progression.HumanOnly ~= true or currentRace == "human")
    	    end

    	    -- Missing replicated prerequisites mean loading, never an empty skill tree.
    	    local points = slot:FindFirstChild("SkillPoints")
    	    local met = slot:FindFirstChild("MetRequirements")
    	    local inventory = slot:FindFirstChild("Inventory")
    	    if not points or type(points.Value) ~= "number" or points.Value ~= points.Value
    	        or points.Value < 0 or points.Value == math.huge
    	        or not slot:FindFirstChild("SkillTreeUnlockedList")
    	        or not slot:FindFirstChild("MasteryProgressionList")
    	        or not met or not met:FindFirstChild("Boss")
    	        or not inventory or not inventory:FindFirstChild("Inventory") then return end

    	    local modules = loadBreathingUnlockModules(isCurrent)
    	    if not modules or not isCurrent() then return end
    	    local power = modules.Breathings[style]
    	    if type(power) ~= "table" then
    	        for name, definition in pairs(modules.Breathings) do
    	            if type(name) == "string" and styleKey(name) == styleKey(style) then
    	                power = definition
    	                break
    	            end
    	        end
    	    end
    	    if type(power) ~= "table" or type(power.Skills) ~= "table" then return end

    	    local names = {}
    	    for _, definition in ipairs(power.Skills) do
    	        if type(definition) ~= "table" or type(definition.Name) ~= "string"
    	            or clean(definition.Name) == "" then return end
    	        if clean(definition.Name):lower() ~= "blocking" then
    	            names[#names + 1] = definition.Name
    	        end
    	    end
    	    if #names == 0 then return end

    	    local pending = unlockState.Pending
    	    if pending then
    	        if pending.Slot ~= slot or pending.Style ~= style then
    	            unlockState.Pending = nil
    	        else
    	            local learned = modules.Stats.IsSkillUnlocked(player, pending.Name)
    	            if not isCurrent() or type(learned) ~= "boolean" then return end
    	            if learned then
    	                unlockState.Pending = nil
    	                print("[Breathing Skills] Confirmed unlocked: " .. pending.Name)
    	            elseif os.clock() < pending.Until then
    	                return
    	            else
    	                unlockState.Pending = nil
    	            end
    	        end
    	    end

    	    local previousName
    	    for index, name in ipairs(names) do
    	        local info = modules.Stats.GetSkillInfoFor(player, name)
    	        if not isCurrent() or type(info) ~= "table" or info.CategoryType ~= "Breathing"
    	            or info.Category ~= style or info.Index ~= index then return end
    	        local learned = modules.Stats.IsSkillUnlocked(player, name)
    	        if not isCurrent() or type(learned) ~= "boolean" then return end
    	        if not learned then
    	            if previousName then
    	                local _, previousReady = modules.Stats.GetRequirements(player, previousName)
    	                if not isCurrent() or previousReady ~= true then return end
    	            end
    	            local requirements = modules.Stats.GetRequirements(player, name)
    	            if not isCurrent() or type(requirements) ~= "table" or next(requirements) == nil then return end
    	            local sourceAllowed = modules.Stats.SourceCheck(player, name)
    	            if not isCurrent() or sourceAllowed ~= true then return end
    	            for requirement, value in pairs(requirements) do
    	                local solver = modules.Tree.RequirementsSolver[requirement]
    	                if type(solver) ~= "table" or type(solver.CanBuy) ~= "function" then return end
    	                local allowed = solver.CanBuy(player, name, value)
    	                if not isCurrent() or allowed ~= true then return end
    	            end
    	            -- The external loader may also unlock skills; recheck just before requesting.
    	            local stillLearned = modules.Stats.IsSkillUnlocked(player, name)
    	            if not isCurrent() or stillLearned ~= false or unlockState.InFlight
    	                or os.clock() < (unlockState.NextAttemptAt or 0) then return end

    	            local owner = {}
    	            local awaiting = {Slot = slot, Style = style, Name = name, Until = os.clock() + 10}
    	            unlockState.InFlight = owner
    	            unlockState.Pending = awaiting
    	            unlockState.NextAttemptAt = os.clock() + 2
    	            local ok, result, message = pcall(modules.Signal.ToServer, "UnlockSkillTreeNode", name)
    	            if unlockState.InFlight == owner then
    	                unlockState.InFlight = nil
    	                if not ok or result == false then
    	                    unlockState.NextAttemptAt = os.clock() + 5
    	                end
    	                if unlockState.Pending == awaiting then
    	                    if ok and result == false then
    	                        unlockState.Pending = nil
    	                    else
    	                        awaiting.Until = os.clock() + 10
    	                    end
    	                end
    	            end
    	            if isCurrent() then
    	                if not ok then
    	                    warn("[Breathing Skills] Unlock request failed: " .. tostring(result))
    	                elseif result == false then
    	                    debugPrint("Breathing Skills", "Unlock denied", name, tostring(message))
    	                else
    	                    debugPrint("Breathing Skills", "Requested", name, "waiting for learned state")
    	                end
    	            end
    	            return
    	        end
    	        previousName = name
    	    end
    	end

    	local function startBreathingSkillUnlocker()
    	    task.spawn(function()
    	        local nextWarningAt = 0
    	        while breathingUnlockRunning() do
    	            local ok, message = pcall(unlockCurrentBreathingSkill)
    	            if not ok and breathingUnlockRunning() and os.clock() >= nextWarningAt then
    	                nextWarningAt = os.clock() + 10
    	                warn("[Breathing Skills] Check failed; will retry: " .. tostring(message))
    	            end
    	            task.wait(1)
    	        end
    	    end)
    	end
    	-- END CURRENT BREATHING SKILL UNLOCKER

    	local breathingIcons = {
    		serpent = "🐍", flame = "🔥", water = "🌊", wind = "🍃",
    		stone = "🪨", insect = "🦋", sound = "🎵", lightning = "⚡"
    	}

    	local function buildAccountTitle(slot, level, style, styleType, allSkillsUnlocked)
    		local clan = slot:FindFirstChild("Clan")
    		local wenValue = slot:FindFirstChild("Wen")
    		local wen = wenValue and tonumber(wenValue.Value)
    		if style == nil or not clan or not wen or wen < 0
    			or wen ~= wen or wen == math.huge then
    			return nil -- Wait for actual data instead of filling in example values.
    		end
    		local styleText
    		if style == "" then
    			styleText = "⚔️ NO STYLE"
    		elseif styleType == "DemonArt" then
    			styleText = "👹 " .. style:upper() .. " DEMON ART"
    		else
    			styleText = (breathingIcons[styleKey(style)] or "⚔️") .. " " .. style:upper() .. " STYLE"
    		end
    		local clanName = clean(clan.Value)
    		local clanText = clanName ~= "" and clanName:upper() .. " CLAN" or "NO CLAN"
    		local levelText = "LV." .. level
    		if level >= Config.AccountDescription.MaxLevel then levelText = levelText .. " MAX" end
    		local wenText
    		-- Round DOWN so the title never claims more Wen than the account has.
    		if wen >= 1000000000 then
    			wenText = math.floor(wen / 1000000000) .. "B WEN+"
    		elseif wen >= 1000000 then
    			wenText = math.floor(wen / 1000000) .. "M WEN+"
    		elseif wen >= 1000 then
    			wenText = math.floor(wen / 1000) .. "K WEN+"
    		else
    			wenText = math.floor(wen) .. " WEN"
    		end
    		return "🔥【SLAYER 2】" .. styleText .. " | ⭐ " .. clanText
    			.. " | 💯 " .. levelText .. " | 💰 " .. wenText
    			.. (allSkillsUnlocked == true and " | DONE" or "")
    	end

    	local function descriptionNumber(value)
    		local digits = string.format("%.0f", math.floor(value))
    		local formatted = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    		return formatted
    	end

    	local function readDescriptionItems(slot)
    		local root = slot:FindFirstChild("Inventory")
    		local inventory = root and root:FindFirstChild("Inventory")
    		if not inventory then return nil end
    		local totals = {}
    		for _, item in ipairs(inventory:GetChildren()) do
    			local name = clean(item.Name):gsub("[%c]", " ")
    			local amountObject = item:FindFirstChild("Amount")
    			local amount = 1
    			if amountObject then amount = tonumber(amountObject.Value) end
    			if not amount or amount < 0 or amount ~= amount or amount == math.huge then
    				return nil -- Wait for valid inventory quantities.
    			end
    			amount = math.floor(amount)
    			if name ~= "" and amount > 0 then
    				totals[name] = (totals[name] or 0) + amount
    			end
    		end
    		local names = {}
    		for name in pairs(totals) do names[#names + 1] = name end
    		table.sort(names)
    		local items = {}
    		for _, name in ipairs(names) do
    			items[#items + 1] = "x" .. descriptionNumber(totals[name]) .. " " .. name
    		end
    		return #items > 0 and table.concat(items, ", ") or "None"
    	end

    	local function buildAccountDescription(slot, level, style, styleType, allSkillsUnlocked, remainingMoves)
    		local title = buildAccountTitle(slot, level, style, styleType, allSkillsUnlocked)
    		if not title then return nil end
    		local items = readDescriptionItems(slot)
    		if not items then return nil end
    		local clanName = clean(slot:FindFirstChild("Clan").Value)
    		local wen = tonumber(slot:FindFirstChild("Wen").Value)
    		local levelText = descriptionNumber(level)
    		if level >= Config.AccountDescription.MaxLevel then levelText = levelText .. " MAX" end
    		local styleLine
    		if style == "" then
    			styleLine = "⚔️ Style: None"
    		elseif styleType == "DemonArt" then
    			styleLine = "👹 Demon Art: " .. style
    		else
    			styleLine = (breathingIcons[styleKey(style)] or "⚔️") .. " Breathing Style: " .. style
    		end
    		local skillsText = "Checking..."
    		if style == "" then
    			skillsText = "No style learned"
    		elseif allSkillsUnlocked == true then
    			skillsText = "All Unlocked"
    		elseif type(remainingMoves) == "table" and #remainingMoves > 0 then
    			skillsText = table.concat(remainingMoves, ", ")
    				.. (#remainingMoves == 1 and " move left" or " moves left")
    		end
    		return table.concat({
    			title,
    			"",
    			"📋 Account Details",
    			"🏆 Level: " .. levelText,
    			styleLine,
    			"⭐ Clan: " .. (clanName ~= "" and clanName or "None"),
    			"💰 Wen: " .. descriptionNumber(wen),
    			"⚔️ Skills: " .. skillsText,
    			"🎒 Items: " .. items,
    			"",
    			"✅ Full Access Account",
    			"⚡ Instant Delivery",
    			"🛠️ 24/7 Support & Warranty"
    		}, "\n"), title
    	end

    	local function updateAccountDescription(player, slot, level, style, styleType, beforeKick, allSkillsUnlocked, remainingMoves)
    		local options = Config.AccountDescription
    		if not options or options.Enabled ~= true then return nil end
    		local description, title = buildAccountDescription(slot, level, style, styleType, allSkillsUnlocked, remainingMoves)
    		if not description then return nil end
    		local requestFunction = request or http_request or (syn and syn.request)
    		if type(requestFunction) ~= "function" then
    			if not descriptionState.WarnedNoRequest then
    				descriptionState.WarnedNoRequest = true
    				warn("[AccountDescription] No request function available; description updates skipped.")
    			end
    			return nil
    		end
    		if description == descriptionState.LastSent or descriptionState.Busy then return description end
    		local interval = math.max(tonumber(options.UpdateInterval) or 30, 1)
    		local finalChange = beforeKick and description ~= descriptionState.LastAttemptDescription
    		if not finalChange and os.clock() - descriptionState.LastAttempt < interval then return description end
    		descriptionState.Busy = true
    		descriptionState.LastAttempt = os.clock()
    		descriptionState.LastAttemptDescription = description
    		task.spawn(function()
    			if not state.Running then descriptionState.Busy = false; return end
    			local ok, response = pcall(function()
    				return requestFunction({
    					Url = options.Url,
    					Method = "PUT",
    					Headers = {["Content-Type"] = "application/json"},
    					Body = HttpService:JSONEncode({username = player.Name, description = description})
    				})
    			end)
    			descriptionState.Busy = false
    			if not state.Running then return end
    			local statusCode = ok and type(response) == "table" and tonumber(response.StatusCode)
    			if statusCode and statusCode >= 200 and statusCode < 300 then
    				descriptionState.LastSent = description
    				print("[AccountDescription] " .. title)
    			else
    				warn("[AccountDescription] Update failed (" .. (statusCode and "HTTP " .. statusCode
    					or ok and "missing HTTP status" or "request/encoding error") .. "); will retry later.")
    			end
    		end)
    		return description
    	end

    	local function matchingBoss(style)
    		for name, bosses in pairs(Config.Progression.BossByStyle) do
    			if styleKey(name) == styleKey(style) then
    				return bosses[1] -- Exactly one boss, including Arrow.
    			end
    		end
    	end

    	local function setStyleAcquisition(level, style, raceName)
        if Config.Progression.HumanOnly == true then
            enforceHumanOnly()
            Config.Breathing.AutoLearn = raceName == "human"
                and level >= Config.Progression.StyleUnlockLevel
                and style == "" and requested.Breathing
            return
        end
    		-- Missing style data must not be treated as an empty style.
    		local canAcquire = raceName ~= nil and level >= Config.Progression.StyleUnlockLevel and style == ""
    		local isDemon = raceName == "demon"
    		local allowDemonArtLearning = Config.Progression.AutoLearnDemonArt ~= false
    		if allowDemonArtLearning and isDemon and canAcquire and not state.DemonArtPrepared then
    			-- If the original choice was Breathing, pick a Demon Art once instead.
    			local options = Config.RandomStart
    			local names = options and options.DemonArtNames
    			if not requested.DemonArt and options and options.Enabled == true
    				and type(names) == "table" and #names > 0 then
    				Config.DemonArt.Orb = names[Random.new():NextInteger(1, #names)]
    			end
    			state.DemonArtPrepared = true
    		end
    		local useDemonArt = allowDemonArtLearning and (isDemon or requested.DemonArt)
    		Config.Breathing.AutoLearn = canAcquire and not isDemon and requested.Breathing
    		Config.DemonArt.Enabled = canAcquire and useDemonArt
    		Config.DemonArt.UseOrb = canAcquire and useDemonArt and requested.UseOrb
    		Config.DemonArt.SpinFallback = canAcquire and useDemonArt and requested.SpinFallback
    	end

    	local function kickForProgress(player, slot, level, style, styleType, message, enableStyleAcquisition, allSkillsUnlocked, remainingMoves)
    		if not state.Running or state.Kicked then return end
    		pause()
    		if enableStyleAcquisition then setStyleAcquisition(level, style, state.RaceName) end
    		state.Kicked = true
    		status(message)
    		local description = updateAccountDescription(player, slot, level, style, styleType, true, allSkillsUnlocked, remainingMoves)
    		local deadline = os.clock() + math.max(tonumber(Config.AccountDescription.BeforeKickWait) or 2, 0)
    		while description and descriptionState.LastSent ~= description and os.clock() < deadline do
    			task.wait(0.1)
    			if not state.Running then return end
    			description = updateAccountDescription(player, slot, level, style, styleType, true, allSkillsUnlocked, remainingMoves) or description
    		end
    		if state.Running then player:Kick(message) end
    	end

    	local function update()
    		if not state.Running or state.Kicked then return end
        enforceHumanOnly()
    		local player = Players.LocalPlayer
    		local slot = player and findSlot(player)
    		if not slot then
    			pause()
    			status("Waiting for the local player's active slot.")
    			return
    		end
    		if state.Slot ~= slot then
    			state.Slot = slot
    			state.LastLevel = nil -- Switching save slots is not a level-up.
    			state.LastStyle = nil -- A style already owned on another slot is not newly learned.
    			state.SkillStyleKey = nil
    			state.LastAllSkillsUnlocked = nil
    		end
    		local level = readLevel(slot)
    		if level == nil then
    			pause()
    			status("Waiting for level data.")
    			return
    		end
    		local target = Config.Progression.TargetLevel
    		local previousLevel = state.LastLevel
    		state.LastLevel = level
    		local style, styleType, raceName = readStyle(slot)
    		state.RaceName = raceName
        state.RaceBlocked = Config.Progression.HumanOnly == true
            and raceName ~= nil and raceName ~= "human"
        if Config.Progression.HumanOnly == true and raceName ~= "human" then
            pause()
            if raceName == nil then
                status("Human-only mode: waiting for confirmed Human race data.")
            else
                status("Human-only mode: current race is " .. raceName
                    .. "; farming paused. Select a Human slot and rerun the script.")
            end
            return
        end
    		local previousStyle = state.LastStyle
    		if style ~= nil then
    			state.LastStyle = style -- Keep the last confirmed value while data is loading.
    		end
    		-- Share one confirmed result between the description and boss progression.
    		-- The DONE suffix depends on skills, even before the level-225 boss stage.
    		local allSkillsUnlocked, remainingMoves = readAllSkillsStatus(player, slot, style, styleType)
    		if Config.Progression.KickOnReachingTarget and previousLevel
    			and previousLevel < target and level >= target then
    			kickForProgress(player, slot, level, style, styleType,
    				"Reached level " .. target .. ". Rejoin to start boss farming.", false, allSkillsUnlocked, remainingMoves)
    			return
    		end
    		local styleLevel = Config.Progression.StyleUnlockLevel
    		if Config.Progression.KickOnReachingStyleLevel and previousLevel
    			and previousLevel < styleLevel and level >= styleLevel then
    			kickForProgress(player, slot, level, style, styleType,
    				"Reached level " .. styleLevel .. ". Rejoin to continue progression.", true, allSkillsUnlocked, remainingMoves)
    			return
    		end

    		if Config.Progression.KickOnObtainingStyle and previousStyle == ""
    			and style and style ~= "" then
    			local kind = styleType == "DemonArt" and "Demon Art" or "Breathing"
    			kickForProgress(player, slot, level, style, styleType,
    				"Obtained " .. style .. " " .. kind .. ". Rejoin to resume farming with style learning off.",
    				false, allSkillsUnlocked, remainingMoves)
    			return
    		end

    		if level >= target and style and style ~= "" then
    			local currentStyleKey = (styleType or "") .. ":" .. styleKey(style)
    			if state.SkillStyleKey ~= currentStyleKey then
    				state.SkillStyleKey = currentStyleKey
    				state.LastAllSkillsUnlocked = nil
    			end
    			if allSkillsUnlocked ~= nil then
    				local previouslyUnlocked = state.LastAllSkillsUnlocked
    				state.LastAllSkillsUnlocked = allSkillsUnlocked
    				if Config.Progression.KickOnAllSkillsUnlocked and previouslyUnlocked == false
    					and allSkillsUnlocked == true then
    					kickForProgress(player, slot, level, style, styleType,
    						"All " .. style .. " skills unlocked. Rejoin to farm all listed bosses.", false, allSkillsUnlocked, remainingMoves)
    					return
    				end
    			end
    		elseif style == "" or level < target then
    			state.SkillStyleKey = nil
    			state.LastAllSkillsUnlocked = nil
    		end

    		updateAccountDescription(player, slot, level, style, styleType, false, allSkillsUnlocked, remainingMoves)
    		local needsStyle = style == "" -- nil means still loading.
    		setStyleAcquisition(level, style, raceName)
    		Config.BossHunt.Enabled = false

    		local demonArtLearningDisabled = Config.Progression.AutoLearnDemonArt == false
    		if level >= styleLevel and (raceName == nil or (raceName == "demon"
                and (style == nil or (needsStyle and not demonArtLearningDisabled)))) then
    			Config.AutoFarm.Enabled = false
    			setBoss(nil)
    			if raceName == nil then
    				status("Level " .. level .. ": waiting for race data.")
    			elseif style == nil then
    				status("Level " .. level .. ": waiting for Demon Art data.")
    			else
    				status("Level " .. level .. ": learning " .. tostring(Config.DemonArt.Orb) .. " Demon Art; leveling OFF until learned.")
    			end
    			return
    		end

    		if level < target then
    			setBoss(nil)
    			Config.AutoFarm.Enabled = true
    			if level < styleLevel then
                    status("Level " .. level .. ": leveling to " .. styleLevel .. "; style learning OFF.")
                elseif Config.Breathing.AutoLearn then
                    status("Level " .. level .. ": learning " .. Config.Breathing.Selected .. " Breathing; leveling ON.")
                elseif Config.DemonArt.Enabled then
                    status("Level " .. level .. ": acquiring " .. tostring(Config.DemonArt.Orb) .. " Demon Art; leveling ON.")
                elseif needsStyle and demonArtLearningDisabled and (raceName == "demon" or requested.DemonArt) then
                    status("Level " .. level .. ": Demon Art learning disabled; leveling to " .. target .. ".")
                else
                    status("Level " .. level .. ": leveling to " .. target .. "; style learning OFF; " .. (style or "style data loading"))
                end
    		else
    			Config.AutoFarm.Enabled = false
    			if allSkillsUnlocked == true then
    				setBosses(Config.Progression.AllBosses)
    				status("Level " .. level .. ": all " .. style .. " skills unlocked; farming all "
    					.. #Config.Progression.AllBosses .. " listed bosses.")
    				return
    			end
    			local boss = style and style ~= "" and matchingBoss(style) or nil
    			setBoss(boss)
    			if boss then
    				status("Level " .. level .. ": " .. style .. " -> " .. boss)
    			elseif style == nil then
    				status("Level " .. level .. ": waiting for style data.")
    			elseif needsStyle then
                    if demonArtLearningDisabled and (raceName == "demon" or requested.DemonArt) then
                        status("Level " .. level .. ": target reached; Demon Art learning disabled; no owned style for boss selection.")
                    else
    				    status("Level " .. level .. ": waiting to obtain the selected style.")
                    end
    			else
    				status("Level " .. level .. ": no boss mapping for " .. style .. "; boss farming off.")
    			end
    		end
    	end

    	local function safeUpdate()
    		local ok, errorMessage = pcall(update)
    		if not ok then
    			pause()
    			status("Check failed: " .. tostring(errorMessage))
    		end
    	end

    	-- Apply already-loaded data before your loader reads Configs.
    	pause()
    	safeUpdate()
    	startBreathingSkillUnlocker()
    	task.spawn(function()
    		while state.Running and not state.Kicked and Config.Progression.Enabled do
    			task.wait(Config.Progression.CheckInterval)
    			if state.Running and Config.Progression.Enabled then safeUpdate() end
    		end
    	end)
    end

    StartProgressionController()
end

local function startSlayerAutomation()
    if game.PlaceId ~= AFK_PLACE_ID then return end
    setWorkflowStatus("Reading player level, race, and owned style...")
    startSlayerProgression()
    local controller = environment.__DemonSlayerProgressionController
    local loader = Config.SlayerLoader
    if not loader or loader.Enabled ~= true then
        setSlayerLoaderStatus("Slayer loader disabled")
        return
    end

    -- Apply the first confirmed progression state before the loader reads Configs.
    setSlayerLoaderStatus("Waiting for player data")
    while controller and controller.Running and not controller.Kicked and not controller.RaceBlocked
        and (controller.LastLevel == nil or controller.LastStyle == nil) do
        task.wait(0.25)
    end
    if versionKickRequested or triggered or game.PlaceId ~= AFK_PLACE_ID
        or (controller and (controller.Kicked or controller.RaceBlocked or not controller.Running)) then
        return
    end

    local previous = environment.__SlayerMainLoaderState
    if type(previous) == "table" and previous.Player == LocalPlayer
        and previous.PlaceId == game.PlaceId and previous.JobId == game.JobId
        and (previous.Status == "loading" or previous.Status == "loaded") then
        setSlayerLoaderStatus(previous.Status == "loaded" and "Slayer loader already started" or "Slayer loader already loading")
        return
    end

    local loaderState = {Player = LocalPlayer, PlaceId = game.PlaceId, JobId = game.JobId, Status = "loading"}
    environment.__SlayerMainLoaderState = loaderState
    setSlayerLoaderStatus("Loading Slayer farming script...")
    local ok, message = pcall(function()
        assert(type(loader.Key) == "string" and loader.Key ~= "", "Set Config.SlayerLoader.Key")
        assert(type(loader.Url) == "string" and loader.Url ~= "", "Set Config.SlayerLoader.Url")
        environment.KEY = loader.Key
        local compiled, compileError = loadstring(game:HttpGet(loader.Url))
        assert(compiled, compileError)
        compiled()
    end)
    if ok then
        loaderState.Status = "loaded"
        setSlayerLoaderStatus("Slayer loader started")
    else
        loaderState.Status = "failed"
        if controller then controller.Running = false end
        local farming = environment.Configs
        farming.AutoFarm.Enabled = false
        farming.BossHunt.Enabled = false
        farming.Bosses.Enabled = false
        farming.Breathing.AutoLearn = false
        farming.DemonArt.Enabled = false
        farming.DemonArt.UseOrb = false
        farming.DemonArt.SpinFallback = false
        setSlayerLoaderStatus("Slayer loader failed")
        setWorkflowStatus("Slayer loader error: " .. tostring(message))
        warn("Slayer loader failed:", message)
    end
end

-- These are client-side route records, not authoritative server ownership data.
-- Teleport settings persist across places within this Roblox experience.
local PRIVATE_ROUTE_KEY = "PrivateAFK.PrivateRoute.v1"
local PRIVATE_ROUTE_MAX_AGE = 300

local function readPrivateRoute()
    local ok, record = pcall(function()
        return TeleportService:GetTeleportSetting(PRIVATE_ROUTE_KEY)
    end)
    if ok and type(record) == "table" then
        return record
    end
    return {}
end

local function writePrivateRoute(record)
    local ok, message = pcall(function()
        TeleportService:SetTeleportSetting(PRIVATE_ROUTE_KEY, record)
    end)
    if not ok then
        warn("Could not save the private-server route guard:", message)
    end
    return ok
end

local function isCurrentPrivateServer(record)
    return type(record) == "table"
        and record.UserId == LocalPlayer.UserId
        and record.PlaceId == game.PlaceId
        and game.JobId ~= ""
        and record.JobId == game.JobId
        and type(record.Owner) == "string"
end

local privateRoute = readPrivateRoute()
if not isCurrentPrivateServer(privateRoute.Current) then
    privateRoute.Current = nil
end
do
    local pending = privateRoute.Pending
    if type(pending) == "table" then
        local age = os.time() - (tonumber(pending.RequestedAt) or 0)
        local fresh = pending.UserId == LocalPlayer.UserId
            and type(pending.Owner) == "string"
            and type(pending.SourceJobId) == "string"
            and pending.SourceJobId ~= ""
            and age >= 0 and age <= PRIVATE_ROUTE_MAX_AGE
        if fresh and pending.PlaceId == game.PlaceId and game.JobId ~= ""
            and pending.SourceJobId ~= game.JobId then
            privateRoute.Current = {
                UserId = LocalPlayer.UserId,
                PlaceId = game.PlaceId,
                JobId = game.JobId,
                Owner = pending.Owner,
            }
            privateRoute.Pending = nil
            debugPrint("Private Guard", "Arrived through a recorded private join; owner =", pending.Owner)
        elseif not fresh or pending.SourceJobId ~= game.JobId then
            privateRoute.Pending = nil
        end
    else
        privateRoute.Pending = nil
    end
end
writePrivateRoute(privateRoute)

local function isInConfiguredFriendServer()
    if game.PlaceId ~= AFK_PLACE_ID then
        return false
    end
    local configuredJob = Config.FriendPrivateServerJobId
    if type(configuredJob) == "string" and configuredJob ~= "" and game.JobId == configuredJob then
        return true
    end
    local current = privateRoute.Current
    return isCurrentPrivateServer(current)
        and type(Config.FriendName) == "string"
        and current.Owner:lower() == Config.FriendName:lower()
end

local function clearPendingPrivateRoute(token)
    local record = readPrivateRoute()
    local pending = record.Pending
    if type(pending) == "table" and (token == nil or pending.Token == token) then
        record.Pending = nil
        writePrivateRoute(record)
    end
end

local function requestTrackedPrivateServer(Teleporter, ownerName, placeId, subtitle)
    local token = game:GetService("HttpService"):GenerateGUID(false)
    local record = readPrivateRoute()
    record.Pending = {
        Token = token,
        UserId = LocalPlayer.UserId,
        Owner = ownerName,
        PlaceId = placeId,
        SourceJobId = game.JobId,
        RequestedAt = os.time(),
    }
    writePrivateRoute(record)

    -- Scope failure cleanup to this request; late callbacks cannot erase a newer route.
    local failureConnection = TeleportService.TeleportInitFailed:Connect(function(player, _, _, failedPlaceId)
        if player == LocalPlayer and failedPlaceId == placeId then
            clearPendingPrivateRoute(token)
        end
    end)
    task.delay(PRIVATE_ROUTE_MAX_AGE, function()
        failureConnection:Disconnect()
        clearPendingPrivateRoute(token)
    end)

    local ok, accepted, reason = pcall(function()
        return Teleporter.Request({
            placeId = placeId,
            privateOwner = ownerName,
        }, {
            Title = "Joining Private Server",
            SubTitle = subtitle,
        })
    end)
    if not ok or not accepted then
        failureConnection:Disconnect()
        clearPendingPrivateRoute(token)
    end
    if not ok then
        error(accepted, 0)
    end
    return accepted, reason
end

