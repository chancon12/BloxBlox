local function debugPrint(section, ...)
    if Config.DebugPrints then
        print("[PrivateAFK][" .. section .. "]", ...)
    end
end

local lastDebugStates = {}
local function debugState(section, state)
    if Config.DebugPrints and lastDebugStates[section] ~= state then
        lastDebugStates[section] = state
        debugPrint(section, state)
    end
end

local function waitForChildDebug(parent, name)
    debugPrint("Wait", parent:GetFullName() .. "." .. name)
    local child = parent:WaitForChild(name)
    debugPrint("Ready", child:GetFullName())
    return child
end

local function requireDebug(module)
    debugPrint("Require", "Loading", module:GetFullName())
    local result = require(module)
    debugPrint("Require", "Loaded", module:GetFullName())
    return result
end

