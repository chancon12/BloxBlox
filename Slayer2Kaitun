local function cancelAFKQuestsOnce()
    if game.PlaceId ~= AFK_PLACE_ID then return end

    local environment = getgenv()
    local previous = environment.__PrivateAFKQuestCancelOnce
    if type(previous) == "table" and previous.Player == LocalPlayer
        and previous.PlaceId == game.PlaceId and previous.JobId == game.JobId then
        return
    end
    local state = {Player = LocalPlayer, PlaceId = game.PlaceId, JobId = game.JobId}
    environment.__PrivateAFKQuestCancelOnce = state

    local success, err = pcall(function()
        local cam = waitForChildDebug(ReplicatedStorage, "CAM")
        local global = waitForChildDebug(cam, "Global")
        local Utility = requireDebug(waitForChildDebug(global, "Utility"))
        local subsets = waitForChildDebug(global, "Subsets")
        local gameplay = waitForChildDebug(subsets, "Gameplay")
        local Quests = requireDebug(waitForChildDebug(gameplay, "Quests"))
        local communication = waitForChildDebug(ReplicatedStorage, "Communication")
        local serverAndClient = waitForChildDebug(communication, "ServerAndClient")
        local signals = waitForChildDebug(serverAndClient, "Signals")
        local SignalEvent = requireDebug(waitForChildDebug(signals, "SignalEvent"))
        assert(type(Quests.Holder) == "table", "Quest definitions are unavailable")

        setWorkflowStatus("Waiting for active quests before starting progression...")
        local deadline = os.clock() + 30
        local holder
        repeat
            if game.PlaceId ~= AFK_PLACE_ID or Players.LocalPlayer ~= LocalPlayer then return end
            local data = Utility.GetData(LocalPlayer, true)
            local questsFolder = data and data:FindFirstChild("Quests")
            holder = questsFolder and questsFolder:FindFirstChild("Holder")
            if not holder then task.wait(0.25) end
        until holder or os.clock() >= deadline
        assert(holder, "Could not find the player's active quest holder")

        -- Take one snapshot; quests accepted later are not cancelled by this pass.
        local activeQuests = holder:GetChildren()
        state.Attempted = true
        local removed = 0
        for _, quest in ipairs(activeQuests) do
            if game.PlaceId ~= AFK_PLACE_ID or Players.LocalPlayer ~= LocalPlayer then break end
            local questString = quest:FindFirstChild("QuestString")
            local questId = questString and questString.Value or quest.Name
            local questInfo = Quests.Holder[questId]

            if not questInfo or questInfo.NoCancel ~= true then
                setWorkflowStatus("Cancelling active quest: " .. quest.Name)
                print("Removing active quest:", quest.Name)
                local sent, cancelError = pcall(SignalEvent.ToServer, "RemoveQuest", quest.Name)
                if sent then
                    removed = removed + 1
                else
                    warn("Quest cancel request failed:", quest.Name, cancelError)
                end
            else
                warn("Quest cannot be cancelled:", quest.Name)
            end
        end
        state.Completed = true
        state.RequestsSent = removed
        print("Cancel requests sent:", removed)
        setWorkflowStatus("Quest cleanup complete: " .. removed .. " cancellation requests sent")
    end)

    if not success then
        warn("One-time quest cancellation failed:", err)
        setWorkflowStatus("Quest cleanup unavailable; continuing to progression")
        -- If no cancellation pass began, a manual rerun may try loading the data again.
        if not state.Attempted and environment.__PrivateAFKQuestCancelOnce == state then
            environment.__PrivateAFKQuestCancelOnce = nil
        end
    end
end

local function applyAFKLowLagSettings()
    if game.PlaceId ~= AFK_PLACE_ID then
        return
    end

    local success, err = pcall(function()
        local communication = waitForChildDebug(ReplicatedStorage, "Communication")
        local serverAndClient = waitForChildDebug(communication, "ServerAndClient")
        local signals = waitForChildDebug(serverAndClient, "Signals")
        local SignalEvent = requireDebug(waitForChildDebug(signals, "SignalEvent"))

        local settings = {
            {"ParticleQuality", 0},
            {"ParticleQualityMine", 0},
            {"ParticleQualityAllies", 0},
            {"ParticleQualityOthers", 0},
            {"ScreenShakeStrength", 0},
            {"MaterialQuality", false},
            {"ShadowQuality", false},
        }

        for _, setting in ipairs(settings) do
            SignalEvent.ToServer(setting[1], setting[2])
            task.wait(0.05)
        end

        print("Low-lag settings applied")
    end)

    if not success then
        warn("Low-lag settings failed:", err)
    end
end

if game.PlaceId == VERSION_PLACE_ID then
    debugPrint("Route", "Main place: GUI, version check, codes, clan rolls, then private-server flow")
    setWorkflowStatus("Waiting for game version...")
    task.spawn(startResourceMonitor)
    task.spawn(function()
        local playerGui = waitForChildDebug(LocalPlayer, "PlayerGui")
        local versionGui = waitForChildDebug(playerGui, "Version")
        versionLabel = waitForChildDebug(versionGui, "Label")

        local function checkVersion()
            if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
                debugPrint("Version", "Check ignored; versionKick =", versionKickRequested, "disconnect =", triggered, "PlaceId =", game.PlaceId)
                return
            end

            local currentVersion = parseVersion(versionLabel.Text)
            debugPrint("Version", "Text =", versionLabel.Text, "Parsed =", currentVersion, "Expected =", Config.ExpectedVersion)

            -- Wait for the game's displayed version to load.
            if currentVersion == nil then
                setWorkflowStatus("Waiting for game version...")
                debugPrint("Version", "Waiting for numeric version text")
                return
            end

            if currentVersion == Config.ExpectedVersion then
                debugPrint("Version", "Version matched")
                setWorkflowStatus("Version matched; starting automation...")
                startMainPlaceAutomation()
                return
            end

            -- Disable freezing BEFORE kicking for a version mismatch.
            versionKickRequested = true
            setWorkflowStatus("Version changed; recheck the script")
            debugPrint("Version", "Mismatch; disabling freeze listener before kick")

            if disconnectConnection then
                disconnectConnection:Disconnect()
                disconnectConnection = nil
            end

            debugPrint("Version", "Kicking: Version change, recheck again.")
            LocalPlayer:Kick("Version change, recheck again.")
        end

        versionLabel:GetPropertyChangedSignal("Text"):Connect(checkVersion)
        debugPrint("Version", "Text-change listener connected; checking current text")
        checkVersion()
    end)
elseif game.PlaceId == AFK_PLACE_ID then
    debugPrint("Route", "AFK place: one-time quest cancellation, low-lag settings, friend check, return timer, and resource monitor")
    setWorkflowStatus("Preparing Slayer progression and clearing active quests...")
    task.spawn(startResourceMonitor)
    task.spawn(applyAFKLowLagSettings)
    startAFKServerRules()
    task.spawn(function()
        cancelAFKQuestsOnce()
        if versionKickRequested or triggered then return end
        startSlayerAutomation()
    end)
else
    debugPrint("Route", "Other place: private-server flow without version check")
    -- Other places keep the existing disconnect rules without a version gate.
    startPrivateJoin()
end

