-- These are client-side route records, not authoritative server ownership data.
-- Teleport settings persist across places within this Roblox experience.
local PRIVATE_ROUTE_KEY = "PrivateAFK.PrivateRoute.v1"
local PRIVATE_ROUTE_MAX_AGE = 300

local function readPrivateRoute()
    local ok, record = pcall(function()
        return TeleportService:GetTeleportSetting(PRIVATE_ROUTE_KEY)
    end)
    if ok and type(record) == "table" then
        return record
    end
    return {}
end

local function writePrivateRoute(record)
    local ok, message = pcall(function()
        TeleportService:SetTeleportSetting(PRIVATE_ROUTE_KEY, record)
    end)
    if not ok then
        warn("Could not save the private-server route guard:", message)
    end
    return ok
end

local function isCurrentPrivateServer(record)
    return type(record) == "table"
        and record.UserId == LocalPlayer.UserId
        and record.PlaceId == game.PlaceId
        and game.JobId ~= ""
        and record.JobId == game.JobId
        and type(record.Owner) == "string"
end

local privateRoute = readPrivateRoute()
if not isCurrentPrivateServer(privateRoute.Current) then
    privateRoute.Current = nil
end
do
    local pending = privateRoute.Pending
    if type(pending) == "table" then
        local age = os.time() - (tonumber(pending.RequestedAt) or 0)
        local fresh = pending.UserId == LocalPlayer.UserId
            and type(pending.Owner) == "string"
            and type(pending.SourceJobId) == "string"
            and pending.SourceJobId ~= ""
            and age >= 0 and age <= PRIVATE_ROUTE_MAX_AGE
        if fresh and pending.PlaceId == game.PlaceId and game.JobId ~= ""
            and pending.SourceJobId ~= game.JobId then
            privateRoute.Current = {
                UserId = LocalPlayer.UserId,
                PlaceId = game.PlaceId,
                JobId = game.JobId,
                Owner = pending.Owner,
            }
            privateRoute.Pending = nil
            debugPrint("Private Guard", "Arrived through a recorded private join; owner =", pending.Owner)
        elseif not fresh or pending.SourceJobId ~= game.JobId then
            privateRoute.Pending = nil
        end
    else
        privateRoute.Pending = nil
    end
end
writePrivateRoute(privateRoute)

local function isInConfiguredFriendServer()
    if game.PlaceId ~= AFK_PLACE_ID then
        return false
    end
    local configuredJob = Config.FriendPrivateServerJobId
    if type(configuredJob) == "string" and configuredJob ~= "" and game.JobId == configuredJob then
        return true
    end
    local current = privateRoute.Current
    return isCurrentPrivateServer(current)
        and type(Config.FriendName) == "string"
        and current.Owner:lower() == Config.FriendName:lower()
end

local function clearPendingPrivateRoute(token)
    local record = readPrivateRoute()
    local pending = record.Pending
    if type(pending) == "table" and (token == nil or pending.Token == token) then
        record.Pending = nil
        writePrivateRoute(record)
    end
end

local function requestTrackedPrivateServer(Teleporter, ownerName, placeId, subtitle)
    local token = game:GetService("HttpService"):GenerateGUID(false)
    local record = readPrivateRoute()
    record.Pending = {
        Token = token,
        UserId = LocalPlayer.UserId,
        Owner = ownerName,
        PlaceId = placeId,
        SourceJobId = game.JobId,
        RequestedAt = os.time(),
    }
    writePrivateRoute(record)

    -- Scope failure cleanup to this request; late callbacks cannot erase a newer route.
    local failureConnection = TeleportService.TeleportInitFailed:Connect(function(player, _, _, failedPlaceId)
        if player == LocalPlayer and failedPlaceId == placeId then
            clearPendingPrivateRoute(token)
        end
    end)
    task.delay(PRIVATE_ROUTE_MAX_AGE, function()
        failureConnection:Disconnect()
        clearPendingPrivateRoute(token)
    end)

    local ok, accepted, reason = pcall(function()
        return Teleporter.Request({
            placeId = placeId,
            privateOwner = ownerName,
        }, {
            Title = "Joining Private Server",
            SubTitle = subtitle,
        })
    end)
    if not ok or not accepted then
        failureConnection:Disconnect()
        clearPendingPrivateRoute(token)
    end
    if not ok then
        error(accepted, 0)
    end
    return accepted, reason
end

debugPrint("Disconnect", "Installing error-message listener")
local success, err = pcall(function()
    disconnectConnection = GuiService.ErrorMessageChanged:Connect(function(message)
        debugPrint("Disconnect", "ErrorMessageChanged =", message)
        -- Never run the freeze attempt in the AFK world, including during teleports.
        if game.PlaceId == AFK_PLACE_ID then
            debugPrint("Disconnect", "Freeze disabled in the AFK place")
            return
        end

        if versionKickRequested or triggered or type(message) ~= "string" then
            debugPrint("Disconnect", "Ignored; versionKick =", versionKickRequested, "alreadyTriggered =", triggered, "messageType =", type(message))
            return
        end

        local text = message:lower()
        local isAuthError = text:find("auth error", 1, true) ~= nil

        if game.PlaceId == VERSION_PLACE_ID and not isAuthError then
            debugPrint("Disconnect", "Ignored by main-place exception; not an auth error")
            return
        end

        local disconnected =
            isAuthError
            or text:find("kicked", 1, true)
            or text:find("disconnect", 1, true)
            or text:find("lost connection", 1, true)
            or text:find("slayers2: please rejoin for safety", 1, true)

        if not disconnected then
            debugPrint("Disconnect", "Ignored; message does not match a disconnect keyword")
            return
        end

        triggered = true
        debugPrint("Disconnect", "Matched disconnect; entering existing freeze attempt")
        warn("Disconnect detected; starting freeze attempt:", message)

        -- Preserves your existing local freeze attempt.
        while true do
        end
    end)
end)

if not success then
    warn("Disconnect listener unavailable:", err)
else
    debugPrint("Disconnect", "Listener connected")
end

local function parseVersion(text)
    if type(text) ~= "string" then
        return nil
    end

    -- The game's label uses "v.194"; plain "194" is also accepted.
    local cleaned = text:match("^%s*(.-)%s*$")
    cleaned = cleaned:gsub("^[vV]%.?%s*", "", 1)
    return tonumber(cleaned)
end

local function canJoinPrivate()
    if versionKickRequested or triggered then
        return false
    end

    if game.PlaceId == VERSION_PLACE_ID then
        return versionLabel ~= nil
            and parseVersion(versionLabel.Text) == Config.ExpectedVersion
    end

    return true
end

local function logPrivateBlocked(stage)
    debugPrint("Private", "Stopped at", stage,
        "versionKick =", versionKickRequested,
        "disconnectTriggered =", triggered,
        "versionText =", versionLabel and versionLabel.Text)
end

local function startPrivateJoin()
    if privateJoinStarted then
        debugPrint("Private", "Join flow already started; duplicate start ignored")
        return
    end

    if not canJoinPrivate() then
        logPrivateBlocked("start")
        return
    end

    privateJoinStarted = true
    debugPrint("Private", "Starting private-server flow; skip own server =", Config.PassOwnPrivateServer == true)

    task.spawn(function()
        local joinSuccess, joinError = pcall(function()
            assert(type(Config.FriendName) == "string" and Config.FriendName ~= "", "Set Config.FriendName at the top")
            assert(Config.FriendName:lower() ~= LocalPlayer.Name:lower(), "FriendName must be another player")

            debugPrint("Private", "Friend configuration passed validation")
            local cam = waitForChildDebug(ReplicatedStorage, "CAM")
            local client = waitForChildDebug(cam, "Client")
            local modules = waitForChildDebug(client, "Modules")
            local teleporterModule = waitForChildDebug(modules, "Teleporter")
            local Teleporter = requireDebug(teleporterModule)

            if not canJoinPrivate() then
                logPrivateBlocked("module loading completed")
                return
            end

            local function joinPrivate(ownerName, subtitle)
                if not canJoinPrivate() then
                    logPrivateBlocked("request for " .. ownerName)
                    return false, "Cancelled"
                end

                debugPrint("Private", "Calling Teleporter.Request; owner =", ownerName, "PlaceId =", Config.PrivateServerPlaceId)
                local requestAccepted, requestReason = requestTrackedPrivateServer(
                    Teleporter, ownerName, Config.PrivateServerPlaceId, subtitle
                )
                debugPrint("Private", "Request returned; owner =", ownerName, "accepted =", requestAccepted, "reason =", requestReason)
                return requestAccepted, requestReason
            end

            local ownReason = "Private-server access is not owned"
            local hasVip = false

            if Config.PassOwnPrivateServer == true then
                ownReason = "Skipped by PassOwnPrivateServer"
                debugPrint("Private", "Own server skipped; joining configured friend directly")
            else
                local global = waitForChildDebug(cam, "Global")
                local vipModule = waitForChildDebug(global, "VipAccess")
                local VipAccess = requireDebug(vipModule)

                if not canJoinPrivate() then
                    logPrivateBlocked("VIP module loading completed")
                    return
                end

                debugPrint("Private", "Checking VipAccess.Has")
                hasVip = VipAccess.Has(LocalPlayer)
                debugPrint("Private", "VipAccess.Has returned =", hasVip)
            end

            if hasVip then
                local joinedOwn
                joinedOwn, ownReason = joinPrivate(
                    LocalPlayer.Name,
                    "Trying your private server"
                )

                if not canJoinPrivate() then
                    logPrivateBlocked("own request completed")
                    return
                end

                if joinedOwn then
                    debugPrint("Private", "Own request accepted; no friend fallback")
                    return
                elseif ownReason == "Busy" then
                    debugPrint("Private", "Own request is Busy; stopping fallback")
                    warn("Another teleport request is already running")
                    return
                end
            end

            if not canJoinPrivate() then
                logPrivateBlocked("before friend fallback")
                return
            end

            debugPrint("Private", "Trying friend =", Config.FriendName, "Own result =", ownReason)
            local joinedFriend, friendReason = joinPrivate(
                Config.FriendName,
                "Trying " .. Config.FriendName .. "'s private server"
            )

            if joinedFriend then
                debugPrint("Private", "Friend request accepted")
            end

            if not joinedFriend and canJoinPrivate() then
                warn(
                    "Private-server join flow failed.",
                    "Own:", ownReason,
                    "Friend:", friendReason
                )
            end
        end)

        debugPrint("Private", "Join task finished; pcall success =", joinSuccess, "error =", joinError)
        if not joinSuccess and not versionKickRequested and not triggered then
            warn("Private-server join failed:", joinError)
        end
    end)
end

local function loadAutomationSignals()
    local communication = waitForChildDebug(ReplicatedStorage, "Communication")
    local serverAndClient = waitForChildDebug(communication, "ServerAndClient")
    local signals = waitForChildDebug(serverAndClient, "Signals")
    return requireDebug(waitForChildDebug(signals, "SignalFunction")),
        requireDebug(waitForChildDebug(signals, "SignalEvent"))
end

local function getRedeemableCodes()
    local codes = {}
    local seen = {}
    local loadedLiveCodes = false

    if Config.RedeemLiveCodes == true then
        local ok, liveCodes = pcall(function()
            local cam = waitForChildDebug(ReplicatedStorage, "CAM")
            local global = waitForChildDebug(cam, "Global")
            local LiveConfig = requireDebug(waitForChildDebug(global, "LiveConfig"))
            return LiveConfig.waitFor("Codes", 15)
        end)

        if ok and type(liveCodes) == "table" and type(liveCodes.free) == "table" then
            for code, entry in pairs(liveCodes.free) do
                local expires = type(entry) == "table" and tonumber(entry.expires) or 0
                if type(code) == "string" and code ~= ""
                    and (not expires or expires <= 0 or expires > os.time()) then
                    seen[code] = true
                    table.insert(codes, code)
                end
            end
            loadedLiveCodes = #codes > 0
        else
            debugPrint("Codes", "Live code config unavailable", liveCodes)
        end
    end

    if not loadedLiveCodes then
        for _, code in ipairs(Config.CodeFallback or {}) do
            if type(code) == "string" and code ~= "" and not seen[code] then
                seen[code] = true
                table.insert(codes, code)
            end
        end
    end

    table.sort(codes)
    return codes
end

local function redeemAllCodes(SignalFunction)
    local codes = getRedeemableCodes()
    local redeemed = 0
    local alreadyRedeemed = {}
    local okStatus, status = pcall(SignalFunction.ToServer, "CodeStatus")

    if okStatus and type(status) == "table" and type(status.codes) == "table" then
        for code, codeStatus in pairs(status.codes) do
            alreadyRedeemed[code] = type(codeStatus) == "table" and codeStatus.redeemed == true
        end
    end

    if #codes == 0 then
        setWorkflowStatus("No active redeem codes were found")
        return redeemed
    end

    for index, code in ipairs(codes) do
        if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
            break
        end

        if alreadyRedeemed[code] then
            setWorkflowStatus(string.format("Code %d/%d already redeemed: %s", index, #codes, code))
        else
            setWorkflowStatus(string.format("Redeeming code %d/%d: %s", index, #codes, code))
            local ok, result = pcall(SignalFunction.ToServer, "RedeemCode", code)
            if ok and result == true then
                redeemed += 1
                debugPrint("Codes", "Redeemed", code)
            else
                debugPrint("Codes", "Not redeemed", code, "ok =", ok, "result =", result)
            end
        end

        task.wait(0.25)
    end

    return redeemed
end

local function rollClanUntilTarget(SignalFunction, SignalEvent)
    local cam = waitForChildDebug(ReplicatedStorage, "CAM")
    local global = waitForChildDebug(cam, "Global")
    local Utility = requireDebug(waitForChildDebug(global, "Utility"))
    local SpinBalance = requireDebug(waitForChildDebug(global, "SpinBalance"))
    local Spinners = requireDebug(waitForChildDebug(global, "Spinners"))
    local Clans = requireDebug(waitForChildDebug(cam, "Clans"))
    local data = Utility.GetData(LocalPlayer, true)

    assert(data, "Player data is unavailable")

    local clanValue = data:WaitForChild("Clan")
    local cost = math.max(tonumber(Spinners.Clan and Spinners.Clan.Cost) or 1, 1)
    local rolls = 0

    while not versionKickRequested and not triggered and game.PlaceId == VERSION_PLACE_ID do
        local currentClan = clanValue.Value
        local currentTier = Clans.TierOf(currentClan)
        local currentRarity = currentTier and currentTier.name or "Unknown"

        if Config.ClanTargetRarities[currentRarity] == true then
            setWorkflowStatus(string.format("Target clan obtained: %s (%s)", currentClan, currentRarity))
            return "Target obtained", rolls
        end

        local balance = SpinBalance.Total(data, true)
        if balance < cost then
            setWorkflowStatus(string.format("Out of clan spins - current clan: %s (%s)", currentClan, currentRarity))
            return "Out of spins", rolls
        end

        setWorkflowStatus(string.format(
            "Rolling clan %d - %d spin%s remaining",
            rolls + 1,
            balance,
            balance == 1 and "" or "s"
        ))

        local ok, rolledClan = pcall(SignalFunction.ToServer, "ClanSpin")
        if not ok or type(rolledClan) ~= "string" then
            setWorkflowStatus("Clan roll failed; continuing to private-server join")
            debugPrint("Clan", "ClanSpin failed", rolledClan)
            return "Roll failed", rolls
        end

        rolls += 1
        task.wait(0.1)
        pcall(SignalEvent.ToServer, "ClanSpinComplete")

        local deadline = os.clock() + 5
        repeat
            task.wait(0.05)
        until clanValue.Value == rolledClan
            or LocalPlayer:GetAttribute("PendingClanSpin") == nil
            or os.clock() >= deadline

        local rolledTier = Clans.TierOf(rolledClan)
        local rolledRarity = rolledTier and rolledTier.name or "Unknown"
        setWorkflowStatus(string.format("Rolled %s (%s)", rolledClan, rolledRarity))

        if Config.ClanTargetRarities[rolledRarity] == true then
            return "Target obtained", rolls
        end

        task.wait(math.max(tonumber(Config.ClanRollInterval) or 0.35, 0.1))
    end

    return "Cancelled", rolls
end

local function startMainPlaceAutomation()
    if mainAutomationStarted then
        return
    end

    if Config.MainAutomationEnabled ~= true then
        setWorkflowStatus("Automation disabled; joining private server")
        startPrivateJoin()
        return
    end

    mainAutomationStarted = true
    task.spawn(function()
        local ok, message = pcall(function()
            local SignalFunction, SignalEvent = loadAutomationSignals()
            setWorkflowStatus("Checking and redeeming active codes...")
            redeemAllCodes(SignalFunction)
            task.wait(0.5)

            setWorkflowStatus("Checking clan and available spins...")
            local stopReason, rolls = rollClanUntilTarget(SignalFunction, SignalEvent)
            debugPrint("Clan", "Stopped =", stopReason, "rolls =", rolls)
        end)

        if not ok then
            warn("Main-place automation failed:", message)
            setWorkflowStatus("Automation error; continuing to private-server join")
        end

        if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
            return
        end

        local delaySeconds = math.max(math.floor(tonumber(Config.PrivateJoinDelay) or 30), 0)
        for remaining = delaySeconds, 1, -1 do
            if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
                return
            end
            setWorkflowStatus(string.format("Joining private server in %ds", remaining))
            task.wait(1)
        end

        setWorkflowStatus("Joining private server...")
        startPrivateJoin()
    end)
end

local function startAFKServerRules()
    if game.PlaceId ~= AFK_PLACE_ID then
        return
    end

    local returnEnabled = Config.AFKReturnEnabled == true
    local timeout = math.max(tonumber(Config.AFKReturnAfterSeconds) or 3600, 0)
    local deadline = returnEnabled and (os.clock() + timeout) or math.huge
    local returnDue = false
    local returnStarted = false
    local friendJoinStarted = false
    local pendingTransfer
    local checkedPlayers = {}
    local requestReturnToMain

    local function isActive()
        return game.PlaceId == AFK_PLACE_ID
            and LocalPlayer.Parent == Players
            and not versionKickRequested
            and not triggered
    end

    local function finishTransfer(transfer)
        if pendingTransfer ~= transfer then
            return
        end
        pendingTransfer = nil
        if returnDue and not returnStarted then
            task.defer(requestReturnToMain)
        end
    end

    requestReturnToMain = function()
        if not returnEnabled then
            return
        end
        returnDue = true
        if not isActive() or returnStarted then
            return
        end
        if pendingTransfer then
            debugPrint("AFK Return", "Timer elapsed; waiting for the pending transfer")
            return
        end

        returnStarted = true
        local transfer = {Kind = "Main return", PlaceId = VERSION_PLACE_ID}
        pendingTransfer = transfer
        debugPrint("AFK Return", "Timer elapsed; teleporting to", VERSION_PLACE_ID)
        clearPendingPrivateRoute()
        local ok, message = pcall(function()
            TeleportService:Teleport(VERSION_PLACE_ID, LocalPlayer)
        end)
        if not ok then
            warn("AFK return teleport failed:", message)
            finishTransfer(transfer)
        end
    end

    TeleportService.TeleportInitFailed:Connect(function(player, result, message, placeId)
        local transfer = pendingTransfer
        if player ~= LocalPlayer or not transfer or placeId ~= transfer.PlaceId then
            return
        end
        warn("AFK teleport failed:", transfer.Kind, result, message)
        finishTransfer(transfer)
    end)

    -- Arm this before any friendship/module/GUI waits when enabled.
    if returnEnabled then
        debugPrint("AFK Return", "Return timer started; seconds =", timeout)
        task.delay(timeout, requestReturnToMain)
    else
        debugPrint("AFK Return", "Timed return disabled")
    end

    if not Config.AFKJoinFriendWhenFriendPresent then
        return
    end
    if isInConfiguredFriendServer() then
        debugPrint("AFK Friend", "Already in the configured friend's server; friend-triggered joins disabled")
        return
    end

    local function checkPlayer(otherPlayer)
        if otherPlayer == LocalPlayer or checkedPlayers[otherPlayer.UserId]
            or friendJoinStarted or returnDue or returnStarted or not isActive() then
            return
        end
        checkedPlayers[otherPlayer.UserId] = true

        task.spawn(function()
            local ok, isFriend = pcall(function()
                return LocalPlayer:IsFriendsWithAsync(otherPlayer.UserId)
            end)
            if not ok then
                warn("AFK friend check failed for", otherPlayer.Name, isFriend)
                return
            end
            if not isFriend or otherPlayer.Parent ~= Players or not isActive()
                or friendJoinStarted or returnDue or returnStarted then
                return
            end
            if os.clock() >= deadline then
                requestReturnToMain()
                return
            end

            -- Claim the one friend-join attempt before module loading can yield.
            friendJoinStarted = true
            debugPrint("AFK Friend", "Friend detected =", otherPlayer.Name, "Joining owner =", Config.FriendName)
            local transfer
            local joinOK, joinError = pcall(function()
                assert(type(Config.FriendName) == "string" and Config.FriendName ~= "", "Set Config.FriendName")
                assert(Config.FriendName:lower() ~= LocalPlayer.Name:lower(), "FriendName must be another player")

                local cam = waitForChildDebug(ReplicatedStorage, "CAM")
                local client = waitForChildDebug(cam, "Client")
                local modules = waitForChildDebug(client, "Modules")
                local Teleporter = requireDebug(waitForChildDebug(modules, "Teleporter"))

                if not isActive() or returnStarted or otherPlayer.Parent ~= Players then
                    return
                end
                if returnDue or os.clock() >= deadline then
                    requestReturnToMain()
                    return
                end

                transfer = {Kind = "Friend private server", PlaceId = AFK_PLACE_ID}
                pendingTransfer = transfer
                -- A yielding/accepted request is not proof that the player left.
                -- Release only this attempt if it stalls, so the hourly return can run.
                task.delay(30, function()
                    if pendingTransfer == transfer and isActive() then
                        debugPrint("AFK Friend", "Still here after 30 seconds; releasing the pending transfer")
                        finishTransfer(transfer)
                    end
                end)
                local accepted, reason = requestTrackedPrivateServer(
                    Teleporter, Config.FriendName, AFK_PLACE_ID,
                    "Joining " .. Config.FriendName .. "'s private server"
                )
                debugPrint("AFK Friend", "Request accepted =", accepted, "reason =", reason)
                if not accepted then
                    warn("AFK friend private-server request failed:", reason)
                    finishTransfer(transfer)
                    return
                end

            end)
            if not joinOK then
                warn("AFK friend private-server join failed:", joinError)
                if transfer then
                    finishTransfer(transfer)
                end
            end
        end)
    end

    -- Connect first so a player joining during the initial scan is not missed.
    Players.PlayerAdded:Connect(checkPlayer)
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        checkPlayer(otherPlayer)
    end
end

