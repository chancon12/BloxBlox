    	Size = UDim2.fromScale(0.48, 0.58),
    	Text = "Wen - 0",
    	TextColor3 = COLORS.Cream,
    	TextScaled = true,
    	TextStrokeColor3 = COLORS.Black,
    	TextStrokeTransparency = 0.25,
    	TextXAlignment = Enum.TextXAlignment.Left,
    	ZIndex = 125,
    }, wenFrame)

    addTextConstraint(wenLabel, 14, 34)

    local openButton = make("TextButton", {
    	Name = "OpenAFK",
    	AnchorPoint = Vector2.new(0, 0.5),
    	AutoButtonColor = false,
    	BackgroundColor3 = COLORS.Panel,
    	BorderSizePixel = 0,
    	Font = Enum.Font.GothamBold,
    	Position = UDim2.fromScale(0.012, 0.5),
		Size = UDim2.fromOffset(58, 62),
		Text = ">>",
    	TextColor3 = COLORS.GoldBright,
    	TextScaled = true,
    	Visible = false,
    	ZIndex = 200,
    }, screenGui)

    addCorner(openButton, 18)
    addStroke(openButton, COLORS.Gold, 2, 0.05)
    addTextConstraint(openButton, 16, 26)

    debugPrint("AFK", "Monitor GUI created")

    local function setOpen(isOpen)
        debugPrint("AFK", "Panel open =", isOpen)
    	overlay.Visible = isOpen
    	openButton.Visible = not isOpen
    end

    closeButton.MouseButton1Click:Connect(function()
    	setOpen(false)
    end)

    openButton.MouseButton1Click:Connect(function()
    	setOpen(true)
    end)

    local function showWaiting()
    	title.Text = targetName .. " - Loading..."
        identityLabel.Text = "Clan: --   •   Race: --   •   Style: --"
        skillStatusLabel.Text = "All Skill Not Unlocked"
        skillStatusLabel.BackgroundColor3 = Color3.fromRGB(80, 48, 20)
        statsLabel.Text = "Combined stats loading..."

    	for index, itemConfig in ipairs(CONFIG.Items) do
    		itemLabels[index].Text = getItemDisplayName(itemConfig) .. " - x0"
    	end

    	wenLabel.Text = "Wen - 0"
        refreshServerInfo()
    end

    local function refresh()
        refreshServerInfo()
    	local profile, profileReason = findProfile()
    	local slot, slotReason = getActiveSlot(profile)

    	if not profile or not slot then
            debugState("AFK Data", profileReason or slotReason or "Waiting for data")
    		showWaiting()
    		return
    	end

        debugState("AFK Data", "Profile ready: " .. profile.Name .. " / " .. slot.Name)
    	title.Text = targetName .. " - Level " .. formatNumber(readLevel(slot))

        local clanName, raceName, styleName, styleText = readIdentity(slot)
        identityLabel.Text = string.format(
            "Clan: %s   •   Race: %s   •   Style: %s",
            clanName,
            raceName,
            styleText
        )

        local allSkillsUnlocked = readAllSkillsStatus(styleName)
        skillStatusLabel.Text = allSkillsUnlocked
            and "All Skill Unlocked"
            or "All Skill Not Unlocked"
        skillStatusLabel.BackgroundColor3 = allSkillsUnlocked
            and Color3.fromRGB(32, 94, 44)
            or Color3.fromRGB(80, 48, 20)
        statsLabel.Text = readCombinedStatText()

    	for index, itemConfig in ipairs(CONFIG.Items) do
    		local total = readItemTotal(slot, itemConfig.Name)
    		itemLabels[index].Text = getItemDisplayName(itemConfig) .. " - x" .. formatNumber(total)
    	end

    	local wen = slot:FindFirstChild("Wen")
        debugState("AFK Wen", wen and "Wen loaded" or "Waiting for Wen")
    	wenLabel.Text = "Wen - " .. formatNumber(wen and wen.Value or 0)

        if Config.DebugPrints then
            local values = {
                title.Text,
                identityLabel.Text,
                skillStatusLabel.Text,
                statsLabel.Text,
                wenLabel.Text,
            }
            for _, itemLabel in ipairs(itemLabels) do
                table.insert(values, itemLabel.Text)
            end
            debugState("AFK Values", table.concat(values, " | "))
        end
    end

    local serverInfoConnections = {
        Players.PlayerAdded:Connect(refreshServerInfo),
        -- ChildRemoved fires after removal, so GetPlayers() has the updated count.
        Players.ChildRemoved:Connect(function(child)
            if child:IsA("Player") then
                refreshServerInfo()
            end
        end),
        Players:GetPropertyChangedSignal("MaxPlayers"):Connect(refreshServerInfo),
    }

    refreshServerInfo()
    showWaiting()
    debugPrint("AFK", "Starting refresh loop")

    task.spawn(function()
    	while screenGui.Parent do
    		local ok, message = pcall(refresh)

    		if not ok then
    			warn("AFK Resource Monitor refresh failed:", message)
    		end

    		task.wait(math.max(CONFIG.RefreshSeconds, 0.1))
    	end
        debugPrint("AFK", "Refresh loop stopped; GUI removed")
    end)

    screenGui.Destroying:Connect(function()
        for _, connection in ipairs(serverInfoConnections) do
            connection:Disconnect()
        end
        debugPrint("AFK", "GUI destroying")
    end)

    debugPrint("AFK", "Monitor setup complete")
end

local function applyAFKLowLagSettings()
    if game.PlaceId ~= AFK_PLACE_ID then
        return
    end

    local success, err = pcall(function()
        local communication = waitForChildDebug(ReplicatedStorage, "Communication")
        local serverAndClient = waitForChildDebug(communication, "ServerAndClient")
        local signals = waitForChildDebug(serverAndClient, "Signals")
        local SignalEvent = requireDebug(waitForChildDebug(signals, "SignalEvent"))

        local settings = {
            {"ParticleQuality", 0},
            {"ParticleQualityMine", 0},
            {"ParticleQualityAllies", 0},
            {"ParticleQualityOthers", 0},
            {"ScreenShakeStrength", 0},
            {"MaterialQuality", false},
            {"ShadowQuality", false},
        }

        for _, setting in ipairs(settings) do
            SignalEvent.ToServer(setting[1], setting[2])
            task.wait(0.05)
        end

        print("Low-lag settings applied")
    end)

    if not success then
        warn("Low-lag settings failed:", err)
    end
end

if game.PlaceId == VERSION_PLACE_ID then
    debugPrint("Route", "Main place: GUI, version check, codes, clan rolls, then private-server flow")
    setWorkflowStatus("Waiting for game version...")
    task.spawn(startResourceMonitor)
    task.spawn(function()
        local playerGui = waitForChildDebug(LocalPlayer, "PlayerGui")
        local versionGui = waitForChildDebug(playerGui, "Version")
        versionLabel = waitForChildDebug(versionGui, "Label")

        local function checkVersion()
            if versionKickRequested or triggered or game.PlaceId ~= VERSION_PLACE_ID then
                debugPrint("Version", "Check ignored; versionKick =", versionKickRequested, "disconnect =", triggered, "PlaceId =", game.PlaceId)
                return
            end

            local currentVersion = parseVersion(versionLabel.Text)
            debugPrint("Version", "Text =", versionLabel.Text, "Parsed =", currentVersion, "Expected =", Config.ExpectedVersion)

            -- Wait for the game's displayed version to load.
            if currentVersion == nil then
                setWorkflowStatus("Waiting for game version...")
                debugPrint("Version", "Waiting for numeric version text")
                return
            end

            if currentVersion == Config.ExpectedVersion then
                debugPrint("Version", "Version matched")
                setWorkflowStatus("Version matched; starting automation...")
                startMainPlaceAutomation()
                return
            end

            -- Disable freezing BEFORE kicking for a version mismatch.
            versionKickRequested = true
            setWorkflowStatus("Version changed; recheck the script")
            debugPrint("Version", "Mismatch; disabling freeze listener before kick")

            if disconnectConnection then
                disconnectConnection:Disconnect()
                disconnectConnection = nil
            end

            debugPrint("Version", "Kicking: Version change, recheck again.")
            LocalPlayer:Kick("Version change, recheck again.")
        end

        versionLabel:GetPropertyChangedSignal("Text"):Connect(checkVersion)
        debugPrint("Version", "Text-change listener connected; checking current text")
        checkVersion()
    end)
elseif game.PlaceId == AFK_PLACE_ID then
    debugPrint("Route", "AFK place: low-lag settings, friend check, return timer, and resource monitor")
    task.spawn(applyAFKLowLagSettings)
    startAFKServerRules()
    task.spawn(startResourceMonitor)
else
    debugPrint("Route", "Other place: private-server flow without version check")
    -- Other places keep the existing disconnect rules without a version gate.
    startPrivateJoin()
end

debugPrint("Startup", "Place handler dispatched; listeners/tasks are active")
