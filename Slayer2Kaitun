        return string.format("%.2f", rounded):gsub("0+$", ""):gsub("%.$", "")
    end

    local function combinedStatValue(statName)
        if not PlayerStatResolver then
            return nil
        end

        local highestOnly = StatTypes and StatTypes.HighestOnlyStats
            and StatTypes.HighestOnlyStats[statName] == true
        local total = 0
        local found = false

        for _, resolverName in ipairs(STAT_RESOLVERS) do
            local ok, value = pcall(
                PlayerStatResolver.GetStat,
                getTargetPlayer(),
                statName,
                resolverName
            )

            if ok and value == true then
                return true
            elseif ok and type(value) == "number" and value ~= 0 then
                total = highestOnly and math.max(total, value) or (total + value)
                found = true
            end
        end

        return found and total or nil
    end

    local function formatStat(statName, value)
        local label = STAT_LABELS[statName] or statName:gsub(" Factor$", "")
        if value == true then
            return label
        end

        local isPercent = statName:sub(-7) == " Factor" or PERCENT_STATS[statName] == true
        local displayValue = isPercent and (value * 100) or value
        local prefix = displayValue > 0 and "+" or ""
        return prefix .. shortNumber(displayValue) .. (isPercent and "% " or " ") .. label
    end

    local function readCombinedStatText()
        if not PlayerStatResolver then
            return "Combined stats loading..."
        end

        local ordered = table.clone(STAT_DISPLAY_ORDER)
        local included = {}
        local extras = {}
        local parts = {}

        for _, statName in ipairs(ordered) do
            included[statName] = true
        end

        if StatTypes and type(StatTypes.StatKeyLookup) == "table" then
            for statName in pairs(StatTypes.StatKeyLookup) do
                if not included[statName] then
                    table.insert(extras, statName)
                end
            end
            table.sort(extras)
            for _, statName in ipairs(extras) do
                table.insert(ordered, statName)
            end
        end

        for _, statName in ipairs(ordered) do
            local value = combinedStatValue(statName)
            if value ~= nil and value ~= false then
                table.insert(parts, formatStat(statName, value))
            end
        end

        return #parts > 0
            and table.concat(parts, "   •   ")
            or "No clan, weapon, or accessory stat buffs"
    end

