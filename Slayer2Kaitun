    local function readIdentity(slot)
        local clan = slot and slot:FindFirstChild("Clan")
        local race = slot and slot:FindFirstChild("Race")
        local powers = slot and slot:FindFirstChild("Powers")
        local breathing = powers and powers:FindFirstChild("Breathing")
        local demonArt = powers and powers:FindFirstChild("DemonArt")
        local raceName = race and tostring(race.Value) or "Unknown"
        local function styleValue(valueObject)
            local value = valueObject and tostring(valueObject.Value):match("^%s*(.-)%s*$") or ""
            local lower = value:lower()
            return (lower == "none" or lower == "nil" or lower == "null" or lower == "n/a") and "" or value
        end
        local breathingName = styleValue(breathing)
        local demonArtName = styleValue(demonArt)
        local styleName = ""
        local styleText = "None"

        if raceName:lower() == "demon" then
            styleName = demonArtName
            styleText = demonArtName ~= "" and (demonArtName .. " Demon Art") or "None"
        elseif breathingName ~= "" then
            styleName = breathingName
            styleText = breathingName .. " Breathing"
        elseif demonArtName ~= "" then
            styleName = demonArtName
            styleText = demonArtName .. " Demon Art"
        end

        return clan and tostring(clan.Value) or "None", raceName, styleName, styleText
    end

    local function readAllSkillsStatus(styleName)
        if styleName == "" or not CharacterInfo then
            return false
        end

        local power = Breathings[styleName] or DemonArts[styleName]
        local skills = {}

        for _, skill in ipairs(type(power) == "table" and power.Skills or {}) do
            if type(skill) == "table" and type(skill.Name) == "string"
                and skill.Name ~= "" and skill.Name ~= "Blocking" then
                table.insert(skills, skill.Name)
            end
        end

        if #skills == 0 then
            return false
        end

        local ok, unlocked = pcall(CharacterInfo.HasUnlockedSkills, getTargetPlayer(), skills)
        return ok and unlocked == true
    end

    local function shortNumber(value)
        local rounded = math.round(value * 100) / 100
        if rounded == math.floor(rounded) then
            return formatNumber(rounded)
        end
        return string.format("%.2f", rounded):gsub("0+$", ""):gsub("%.$", "")
    end

    local function combinedStatValue(statName)
        if not PlayerStatResolver then
            return nil
        end

        local highestOnly = StatTypes and StatTypes.HighestOnlyStats
            and StatTypes.HighestOnlyStats[statName] == true
        local total = 0
        local found = false

        for _, resolverName in ipairs(STAT_RESOLVERS) do
            local ok, value = pcall(
                PlayerStatResolver.GetStat,
                getTargetPlayer(),
                statName,
                resolverName
            )

            if ok and value == true then
                return true
            elseif ok and type(value) == "number" and value ~= 0 then
                total = highestOnly and math.max(total, value) or (total + value)
                found = true
            end
        end

        return found and total or nil
    end

    local function formatStat(statName, value)
        local label = STAT_LABELS[statName] or statName:gsub(" Factor$", "")
        if value == true then
            return label
        end

        local isPercent = statName:sub(-7) == " Factor" or PERCENT_STATS[statName] == true
        local displayValue = isPercent and (value * 100) or value
        local prefix = displayValue > 0 and "+" or ""
        return prefix .. shortNumber(displayValue) .. (isPercent and "% " or " ") .. label
    end

    local function readCombinedStatText()
        if not PlayerStatResolver then
            return "Combined stats loading..."
        end

        local ordered = table.clone(STAT_DISPLAY_ORDER)
        local included = {}
        local extras = {}
        local parts = {}

        for _, statName in ipairs(ordered) do
            included[statName] = true
        end

        if StatTypes and type(StatTypes.StatKeyLookup) == "table" then
            for statName in pairs(StatTypes.StatKeyLookup) do
                if not included[statName] then
                    table.insert(extras, statName)
                end
            end
            table.sort(extras)
            for _, statName in ipairs(extras) do
                table.insert(ordered, statName)
            end
        end

        for _, statName in ipairs(ordered) do
            local value = combinedStatValue(statName)
            if value ~= nil and value ~= false then
                table.insert(parts, formatStat(statName, value))
            end
        end

        return #parts > 0
            and table.concat(parts, "   •   ")
            or "No clan, weapon, or accessory stat buffs"
    end

